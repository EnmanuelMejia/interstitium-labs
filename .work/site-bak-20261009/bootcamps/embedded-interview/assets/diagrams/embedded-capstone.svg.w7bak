<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Capstone: wireless sensor node</title>
  <desc>A sensor node: the sensor feeds the MCU, the radio links the gateway, the gateway reaches the cloud.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Capstone: wireless sensor node</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">EMBEDDED INTERVIEW</text>  <line x1="128" y1="220" x2="164" y2="220" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="146" y="214" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">sample</text>  <line x1="282" y1="220" x2="324" y2="220" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="303" y="214" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">UART/SPI</text>  <line x1="428" y1="220" x2="460" y2="220" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="444" y="214" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">wireless</text>  <rect x="30" y="190" width="96" height="60" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="78" y="215" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#eef3fa">Sensor</text>  <text x="78" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">I2C/SPI</text>  <circle cx="225" cy="220" r="55" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="225" y="215" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">MCU</text>  <text x="225" y="232" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#9fb0c8">firmware</text>  <rect x="330" y="196" width="96" height="48" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="378" y="215" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Radio</text>  <text x="378" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">LoRa/BLE</text>  <rect x="466" y="190" width="104" height="60" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="518" y="215" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#eef3fa">Gateway</text>  <text x="518" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">to cloud</text></svg>
