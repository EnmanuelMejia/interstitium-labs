<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>MCU memory map: where your bytes live</title>
  <desc>Firmware lives in flash (.text), constants in flash, initialized data copied to RAM, BSS zeroed, heap grows up, stack grows down.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">MCU memory map: where your bytes live</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">EMBEDDED INTERVIEW</text>  <rect x="56" y="74" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="74" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="88" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Flash: .text</text>  <text x="78" y="106" font-family="sans-serif" font-size="11" fill="#9fb0c8">code</text>  <line x1="300" y1="111" x2="300" y2="117" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="118" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="118" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="132" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Flash: constants</text>  <text x="78" y="150" font-family="sans-serif" font-size="11" fill="#9fb0c8">rodata</text>  <line x1="300" y1="155" x2="300" y2="161" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="162" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="162" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="176" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">RAM: .data</text>  <text x="78" y="194" font-family="sans-serif" font-size="11" fill="#9fb0c8">initialized</text>  <line x1="300" y1="199" x2="300" y2="205" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="206" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="206" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="220" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">RAM: .bss</text>  <text x="78" y="238" font-family="sans-serif" font-size="11" fill="#9fb0c8">zeroed</text>  <line x1="300" y1="243" x2="300" y2="249" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="250" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="250" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="264" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Heap</text>  <text x="78" y="282" font-family="sans-serif" font-size="11" fill="#9fb0c8">malloc, grows up</text>  <line x1="300" y1="287" x2="300" y2="293" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="294" width="488" height="36" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="294" width="7" height="36" fill="#e8a33d"/>  <text x="78" y="308" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Stack</text>  <text x="78" y="326" font-family="sans-serif" font-size="11" fill="#9fb0c8">frames, grows down</text></svg>
