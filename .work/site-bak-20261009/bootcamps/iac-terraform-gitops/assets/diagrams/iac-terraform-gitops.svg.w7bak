<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Terraform GitOps: PR to applied</title>
  <desc>GitOps for infra: code the change, open a PR, plan shows the diff, apply converges, state records truth, drift detection watches.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Terraform GitOps: PR to applied</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">IAC TERRAFORM GITOPS</text>  <rect x="170" y="72" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="86" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Code</text>  <text x="300" y="104" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">HCL</text>  <line x1="300" y1="111" x2="300" y2="123" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="124" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="138" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">PR</text>  <text x="300" y="156" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">review</text>  <line x1="300" y1="163" x2="300" y2="175" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="176" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="190" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Plan</text>  <text x="300" y="208" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">diff</text>  <line x1="300" y1="216" x2="300" y2="228" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="229" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="243" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Apply</text>  <text x="300" y="261" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">converge</text>  <line x1="300" y1="268" x2="300" y2="280" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="281" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="295" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">State</text>  <text x="300" y="313" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">truth</text>  <line x1="300" y1="320" x2="300" y2="332" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="333" width="260" height="38" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="347" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Drift</text>  <text x="300" y="365" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">detect</text></svg>
