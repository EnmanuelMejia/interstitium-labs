<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Operational procedures cycle</title>
  <desc>Procedures are a cycle: safety first, communicate professionally, document, control changes, stay compliant, dispose properly.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Operational procedures cycle</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">COMPTIA A PLUS</text>  <line x1="348" y1="122" x2="351" y2="124" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="405" y1="211" x2="405" y2="215" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="357" y1="305" x2="353" y2="307" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="251" y1="310" x2="248" y2="308" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="194" y1="221" x2="194" y2="217" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="242" y1="127" x2="246" y2="125" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="238" y="68" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="300" y="89" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Safety</text>  <text x="300" y="107" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">ESD, power</text>  <rect x="343" y="129" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="405" y="150" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Professionalism</text>  <text x="405" y="168" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">communicate</text>  <rect x="343" y="251" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="405" y="272" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Documentation</text>  <text x="405" y="290" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">ticket notes</text>  <rect x="238" y="312" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="300" y="333" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Change control</text>  <text x="300" y="351" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">approvals</text>  <rect x="132" y="251" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="194" y="272" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Compliance</text>  <text x="194" y="290" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">licensing</text>  <rect x="132" y="129" width="124" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="194" y="150" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Disposal</text>  <text x="194" y="168" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">e-waste</text></svg>
