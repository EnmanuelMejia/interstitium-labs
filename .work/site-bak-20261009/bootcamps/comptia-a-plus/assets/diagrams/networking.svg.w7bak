<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>SOHO network: from ISP to printer</title>
  <desc>A SOHO chain: ISP modem hands off to the router, which serves the switch, PCs, and the shared printer.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">SOHO network: from ISP to printer</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">COMPTIA A PLUS</text>  <line x1="124" y1="218" x2="164" y2="218" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="144" y="212" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">WAN</text>  <line x1="272" y1="218" x2="314" y2="218" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="293" y="212" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">LAN</text>  <line x1="420" y1="203" x2="469" y2="159" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="424" y1="226" x2="465" y2="248" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="30" y="190" width="92" height="56" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="76" y="222" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">ISP modem</text>  <circle cx="220" cy="218" r="50" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="220" y="213" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Router</text>  <text x="220" y="230" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#9fb0c8">DHCP/NAT</text>  <rect x="320" y="186" width="104" height="64" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="372" y="213" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Switch</text>  <text x="372" y="231" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">L2</text>  <rect x="470" y="120" width="100" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="520" y="150" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#eef3fa">PC</text>  <rect x="470" y="230" width="100" height="52" rx="10" fill="#141d33" stroke="#e8442e" stroke-width="2"/>  <text x="520" y="260" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#eef3fa">Printer</text></svg>
