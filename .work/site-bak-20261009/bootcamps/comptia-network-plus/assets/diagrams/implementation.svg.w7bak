<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Enterprise implementation: three-tier with VLANs</title>
  <desc>Three tiers: core routes fast, distribution enforces policy, access connects users on separate VLANs.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Enterprise implementation: three-tier with VLANs</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">COMPTIA NETWORK PLUS</text>  <line x1="259" y1="126" x2="223" y2="187" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="350" y1="126" x2="386" y2="187" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="149" y1="234" x2="149" y2="287" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="149" y="255" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">trunk</text>  <line x1="217" y1="227" x2="250" y2="295" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="234" y="255" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">trunk</text>  <line x1="390" y1="226" x2="351" y2="296" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="370" y="255" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">trunk</text>  <line x1="456" y1="235" x2="455" y2="286" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="455" y="255" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">trunk</text>  <rect x="250" y="80" width="110" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="305" y="103" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Core</text>  <text x="305" y="121" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">fast routing</text>  <rect x="120" y="180" width="110" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="175" y="203" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Distribution</text>  <text x="175" y="221" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">policy</text>  <rect x="380" y="180" width="110" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="435" y="203" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Distribution</text>  <text x="435" y="221" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">policy</text>  <rect x="60" y="290" width="120" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="120" y="322" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Access: VLAN 10</text>  <rect x="240" y="290" width="120" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="322" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Access: VLAN 20</text>  <rect x="420" y="290" width="120" height="56" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="480" y="322" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Access: VLAN 30</text></svg>
