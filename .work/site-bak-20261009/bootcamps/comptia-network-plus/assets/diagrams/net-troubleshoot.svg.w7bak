<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Network troubleshooting: seven steps</title>
  <desc>Wired method: identify symptoms, theorize, test, plan, implement, verify, document.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Network troubleshooting: seven steps</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">COMPTIA NETWORK PLUS</text>  <rect x="170" y="72" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="82" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Identify</text>  <text x="300" y="100" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">symptoms</text>  <line x1="300" y1="103" x2="300" y2="115" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="116" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="127" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Theorize</text>  <text x="300" y="145" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">cause</text>  <line x1="300" y1="148" x2="300" y2="160" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="161" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="172" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Test</text>  <text x="300" y="190" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">hypothesis</text>  <line x1="300" y1="193" x2="300" y2="205" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="206" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="217" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Plan</text>  <text x="300" y="235" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">roll back ready</text>  <line x1="300" y1="238" x2="300" y2="250" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="251" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="261" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Implement</text>  <text x="300" y="279" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">change</text>  <line x1="300" y1="283" x2="300" y2="295" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="296" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="306" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Verify</text>  <text x="300" y="324" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">full function</text>  <line x1="300" y1="328" x2="300" y2="340" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="170" y="341" width="260" height="30" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="300" y="351" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Document</text>  <text x="300" y="369" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">lessons</text></svg>
