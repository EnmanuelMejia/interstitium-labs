<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Network operations: the run loop</title>
  <desc>Operations is a run loop: monitor baselines, analyze deviations, optimize, maintain.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Network operations: the run loop</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">COMPTIA NETWORK PLUS</text>  <rect x="40" y="160" width="104" height="92" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="92" y="201" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Monitor</text>  <text x="92" y="219" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">baselines</text>  <line x1="146" y1="206" x2="176" y2="206" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="178" y="160" width="104" height="92" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="230" y="201" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Analyze</text>  <text x="230" y="219" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">deviations</text>  <line x1="285" y1="206" x2="315" y2="206" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="317" y="160" width="104" height="92" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="369" y="201" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Optimize</text>  <text x="369" y="219" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">tune</text>  <line x1="423" y1="206" x2="453" y2="206" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="455" y="160" width="104" height="92" rx="10" fill="#141d33" stroke="#2e9de8" stroke-width="2"/>  <text x="507" y="201" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Maintain</text>  <text x="507" y="219" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">patch</text></svg>
