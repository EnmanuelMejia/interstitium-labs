<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Security graph: entities and relationships</title>
  <desc>Graph-powered defense links users, hosts, IPs, and files; attack paths are traversals across these relationships.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Security graph: entities and relationships</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">SECURITY GRAPHS</text>  <line x1="171" y1="113" x2="244" y2="99" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="208" y="100" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">LOGGED_IN</text>  <line x1="361" y1="99" x2="414" y2="112" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="388" y="99" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">CONN_TO</text>  <line x1="276" y1="120" x2="235" y2="238" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="256" y="173" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">WROTE</text>  <line x1="455" y1="142" x2="442" y2="235" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="449" y="183" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">RESOLVES</text>  <line x1="262" y1="266" x2="354" y2="266" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="308" y="260" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">BEACONS</text>  <rect x="60" y="90" width="110" height="52" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="115" y="111" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">User</text>  <text x="115" y="129" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">alice@corp</text>  <rect x="250" y="70" width="110" height="52" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="305" y="91" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Host</text>  <text x="305" y="109" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">WS-042</text>  <rect x="420" y="90" width="110" height="52" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="475" y="111" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">IP</text>  <text x="475" y="129" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">203.0.113.7</text>  <rect x="150" y="240" width="110" height="52" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="205" y="261" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">File</text>  <text x="205" y="279" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">payload.exe</text>  <rect x="360" y="240" width="120" height="52" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="420" y="261" text-anchor="middle" font-family="sans-serif" font-size="10.5" font-weight="700" fill="#eef3fa">Domain</text>  <text x="420" y="279" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">evil.example</text></svg>
