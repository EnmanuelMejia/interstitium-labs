<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Humanmetrics: four dichotomies</title>
  <desc>The assessment sorts four preferences: energy source, information style, decision basis, and lifestyle orientation.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Humanmetrics: four dichotomies</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">HUMANMETRICS</text>  <rect x="40" y="76" width="160" height="128" rx="10" fill="#141d33" stroke="#14b8a6" stroke-width="2"/>  <text x="120" y="135" text-anchor="middle" font-family="sans-serif" font-size="12.5" font-weight="700" fill="#eef3fa">E / I</text>  <text x="120" y="153" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">energy</text>  <rect x="220" y="76" width="160" height="128" rx="10" fill="#141d33" stroke="#14b8a6" stroke-width="2"/>  <text x="300" y="135" text-anchor="middle" font-family="sans-serif" font-size="12.5" font-weight="700" fill="#eef3fa">S / N</text>  <text x="300" y="153" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">information</text>  <rect x="400" y="76" width="160" height="128" rx="10" fill="#141d33" stroke="#14b8a6" stroke-width="2"/>  <text x="480" y="135" text-anchor="middle" font-family="sans-serif" font-size="12.5" font-weight="700" fill="#eef3fa">T / F</text>  <text x="480" y="153" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">decisions</text>  <rect x="40" y="226" width="160" height="128" rx="10" fill="#141d33" stroke="#14b8a6" stroke-width="2"/>  <text x="120" y="285" text-anchor="middle" font-family="sans-serif" font-size="12.5" font-weight="700" fill="#eef3fa">J / P</text>  <text x="120" y="303" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">lifestyle</text></svg>
