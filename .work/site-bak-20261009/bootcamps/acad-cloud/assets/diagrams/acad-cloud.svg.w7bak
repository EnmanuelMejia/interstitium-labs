<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Cloud stack: five layers of the shared-responsibility model</title>
  <desc>Every cloud workload rests on five layers; you own more of the lower layers in IaaS and less in SaaS.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Cloud stack: five layers of the shared-responsibility model</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">ACAD CLOUD</text>  <rect x="56" y="74" width="488" height="44" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="74" width="7" height="44" fill="#e5484d"/>  <text x="78" y="92" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Edge &amp; CDN</text>  <text x="78" y="110" font-family="sans-serif" font-size="11" fill="#9fb0c8">cache close to users</text>  <line x1="300" y1="119" x2="300" y2="131" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="132" width="488" height="44" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="132" width="7" height="44" fill="#e5484d"/>  <text x="78" y="150" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Compute</text>  <text x="78" y="168" font-family="sans-serif" font-size="11" fill="#9fb0c8">VMs and containers</text>  <line x1="300" y1="177" x2="300" y2="189" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="190" width="488" height="44" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="190" width="7" height="44" fill="#e5484d"/>  <text x="78" y="208" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Storage</text>  <text x="78" y="226" font-family="sans-serif" font-size="11" fill="#9fb0c8">object and block</text>  <line x1="300" y1="235" x2="300" y2="247" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="248" width="488" height="44" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="248" width="7" height="44" fill="#e5484d"/>  <text x="78" y="266" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Networking</text>  <text x="78" y="284" font-family="sans-serif" font-size="11" fill="#9fb0c8">VPCs and routing</text>  <line x1="300" y1="293" x2="300" y2="305" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="56" y="306" width="488" height="44" rx="9" fill="#141d33" stroke="#2b3a5c" stroke-width="1.6"/>  <rect x="56" y="306" width="7" height="44" fill="#e5484d"/>  <text x="78" y="324" font-family="sans-serif" font-size="13.5" font-weight="700" fill="#eef3fa">Identity &amp; security</text>  <text x="78" y="342" font-family="sans-serif" font-size="11" fill="#9fb0c8">who can touch what</text></svg>
