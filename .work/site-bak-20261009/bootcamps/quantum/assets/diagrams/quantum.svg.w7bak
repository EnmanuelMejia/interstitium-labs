<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Quantum computing: the qubit and beyond</title>
  <desc>Quantum computing: qubits in superposition, entanglement as resource, gates as operations, algorithms like Shor and Grover, error correction, and the post-quantum crypto transition.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Quantum computing: the qubit and beyond</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">QUANTUM</text>  <line x1="300" y1="212" x2="300" y2="94" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="473" y2="153" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="473" y2="271" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="300" y2="330" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="126" y2="271" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="126" y2="153" stroke="#55688c" stroke-width="1.5"/>  <rect x="215" y="182" width="170" height="60" rx="10" fill="#141d33" stroke="#06b6d4" stroke-width="2"/>  <text x="300" y="207" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="700" fill="#eef3fa">Qubit</text>  <text x="300" y="225" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">quantum bit</text>  <rect x="236" y="70" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="300" y="89" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Superposition</text>  <text x="300" y="107" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">0 and 1</text>  <rect x="409" y="129" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="473" y="148" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Entanglement</text>  <text x="473" y="166" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">correlation</text>  <rect x="409" y="247" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="473" y="266" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Gates</text>  <text x="473" y="284" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">unitary ops</text>  <rect x="236" y="306" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="300" y="325" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Algorithms</text>  <text x="300" y="343" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">Shor, Grover</text>  <rect x="62" y="247" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="126" y="266" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Error corr.</text>  <text x="126" y="284" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">logical qubits</text>  <rect x="62" y="129" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="126" y="148" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">PQC</text>  <text x="126" y="166" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">crypto future</text></svg>
