<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Campus access: hosts to the wire</title>
  <desc>Access switches connect endpoints on access ports; uplinks trunk VLANs toward the router.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Campus access: hosts to the wire</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">CISCO CCNA</text>  <line x1="136" y1="155" x2="216" y2="192" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="176" y="168" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">access</text>  <line x1="136" y1="250" x2="216" y2="213" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="176" y="225" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">access</text>  <line x1="361" y1="201" x2="414" y2="197" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="387" y="193" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">trunk</text>  <line x1="511" y1="197" x2="514" y2="198" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <text x="512" y="192" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#8fa3c4">route</text>  <rect x="36" y="120" width="100" height="56" rx="10" fill="#141d33" stroke="#1ba0d7" stroke-width="2"/>  <text x="86" y="143" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">PC-A</text>  <text x="86" y="161" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">VLAN 10</text>  <rect x="36" y="230" width="100" height="56" rx="10" fill="#141d33" stroke="#1ba0d7" stroke-width="2"/>  <text x="86" y="253" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">PC-B</text>  <text x="86" y="271" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">VLAN 20</text>  <rect x="220" y="170" width="140" height="66" rx="10" fill="#141d33" stroke="#1ba0d7" stroke-width="2"/>  <text x="290" y="198" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Access switch</text>  <text x="290" y="216" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">L2</text>  <circle cx="465" cy="195" r="45" fill="#141d33" stroke="#1ba0d7" stroke-width="2"/>  <text x="465" y="190" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="700" fill="#eef3fa">Router</text>  <text x="465" y="207" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#9fb0c8">gateway</text>  <rect x="520" y="178" width="64" height="44" rx="10" fill="#141d33" stroke="#1ba0d7" stroke-width="2"/>  <text x="552" y="204" text-anchor="middle" font-family="sans-serif" font-size="10" font-weight="700" fill="#eef3fa">WAN</text></svg>
