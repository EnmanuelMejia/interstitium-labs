"242" stroke="#2c3d61" stroke-width="1"/>  <line x1="360" y1="320" x2="490" y2="190" stroke="#2c3d61" stroke-width="1"/>  <line x1="360" y1="320" x2="490" y2="242" stroke="#2c3d61" stroke-width="1"/>  <circle cx="110" cy="164" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="110" cy="216" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="110" cy="268" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <text x="110" y="356" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#9fb0c8">Input</text>  <circle cx="240" cy="112" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="240" cy="164" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="240" cy="216" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="240" cy="268" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="240" cy="320" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <text x="240" y="356" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#9fb0c8">Hidden 1</text>  <circle cx="360" cy="112" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="360" cy="164" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="360" cy="216" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="360" cy="268" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="360" cy="320" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <text x="360" y="356" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#9fb0c8">Hidden 2</text>  <circle cx="490" cy="190" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <circle cx="490" cy="242" r="15" fill="#141d33" stroke="#f97316" stroke-width="2"/>  <text x="490" y="356" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#9fb0c8">Output</text>  <text x="300" y="386" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#7f93b3">Forward pass: weighted sums + activation; training adjusts weights via backpropagation.</text></svg>
