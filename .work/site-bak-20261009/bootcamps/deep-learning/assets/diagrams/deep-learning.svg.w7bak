<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Neural network: input to output</title>
  <desc>A feedforward network: inputs flow through two hidden layers to outputs; training tunes every weight by backpropagation.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Neural network: input to output</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">DEEP LEARNING</text>  <line x1="110" y1="164" x2="240" y2="112" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="164" x2="240" y2="164" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="164" x2="240" y2="216" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="164" x2="240" y2="268" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="164" x2="240" y2="320" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="216" x2="240" y2="112" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="216" x2="240" y2="164" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="216" x2="240" y2="216" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="216" x2="240" y2="268" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="216" x2="240" y2="320" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="268" x2="240" y2="112" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="268" x2="240" y2="164" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="268" x2="240" y2="216" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="268" x2="240" y2="268" stroke="#2c3d61" stroke-width="1"/>  <line x1="110" y1="268" x2="240" y2="320" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="112" x2="360" y2="112" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="112" x2="360" y2="164" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="112" x2="360" y2="216" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="112" x2="360" y2="268" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="112" x2="360" y2="320" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="164" x2="360" y2="112" stroke="#2c3d61" stroke-width="1"/>  <line x1="240" y1="164" x2="360" y2="164" stroke="#2c3d61" stroke-width="1"/>  <line x1="2