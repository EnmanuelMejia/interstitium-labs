<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>AD forest anatomy: the unit you must defend</title>
  <desc>The forest is the security boundary. Defend tier 0 first: domain controllers and privileged accounts decide every breach.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">AD forest anatomy: the unit you must defend</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">ACTIVE DIRECTORY DEFENSE</text>  <rect x="230" y="70" width="140" height="56" rx="10" fill="#141d33" stroke="#a855f7" stroke-width="2"/>  <text x="300" y="93" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="700" fill="#eef3fa">Forest</text>  <text x="300" y="111" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">security boundary</text>  <line x1="300" y1="126" x2="123" y2="190" stroke="#55688c" stroke-width="1.5"/>  <rect x="48" y="190" width="150" height="60" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="123" y="215" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Domain: corp</text>  <text x="123" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">Kerberos realm</text>  <line x1="123" y1="250" x2="123" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="73" y1="254" x2="173" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="73" y1="254" x2="73" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="50" y="262" width="46" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="73" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">Workstations</text>  <line x1="123" y1="254" x2="123" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="100" y="262" width="46" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="123" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">Servers</text>  <line x1="173" y1="254" x2="173" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="150" y="262" width="46" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="173" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">Admins</text>  <line x1="300" y1="126" x2="310" y2="190" stroke="#55688c" stroke-width="1.5"/>  <rect x="235" y="190" width="150" height="60" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="310" y="215" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Domain: branch</text>  <text x="310" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">child domain</text>  <line x1="310" y1="250" x2="310" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="272" y1="254" x2="347" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="272" y1="254" x2="272" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="237" y="262" width="71" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="272" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">Users</text>  <line x1="347" y1="254" x2="347" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="312" y="262" width="71" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="347" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">Laptops</text>  <line x1="300" y1="126" x2="496" y2="190" stroke="#55688c" stroke-width="1.5"/>  <rect x="421" y="190" width="150" height="60" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="496" y="215" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Tier 0</text>  <text x="496" y="233" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">privileged access</text>  <line x1="496" y1="250" x2="496" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="459" y1="254" x2="534" y2="254" stroke="#55688c" stroke-width="1.5"/>  <line x1="459" y1="254" x2="459" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="423" y="262" width="71" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="459" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">DCs</text>  <line x1="534" y1="254" x2="534" y2="262" stroke="#55688c" stroke-width="1.5"/>  <rect x="498" y="262" width="71" height="34" rx="7" fill="#101829" stroke="#33456b" stroke-width="1.4"/>  <text x="534" y="282" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#c4d2e8">AD admins</text></svg>
