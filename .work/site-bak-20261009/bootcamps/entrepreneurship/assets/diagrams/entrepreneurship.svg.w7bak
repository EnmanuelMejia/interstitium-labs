<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>The lean loop: build, measure, learn</title>
  <desc>Entrepreneurship is validated learning: build the smallest thing, measure real behavior, learn, repeat.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">The lean loop: build, measure, learn</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">ENTREPRENEURSHIP</text>  <line x1="345" y1="126" x2="365" y2="141" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="398" y1="231" x2="390" y2="255" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="315" y1="314" x2="290" y2="314" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="210" y1="261" x2="203" y2="237" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <line x1="229" y1="145" x2="249" y2="130" stroke="#7d8fb0" stroke-width="1.8" marker-end="url(#arr)"/>  <rect x="238" y="68" width="124" height="52" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="300" y="89" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Build</text>  <text x="300" y="107" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">MVP</text>  <rect x="354" y="152" width="124" height="52" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="416" y="173" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Measure</text>  <text x="416" y="191" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">metrics</text>  <rect x="309" y="288" width="124" height="52" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="371" y="309" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Learn</text>  <text x="371" y="327" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">insight</text>  <rect x="166" y="288" width="124" height="52" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="228" y="309" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Pivot?</text>  <text x="228" y="327" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">decide</text>  <rect x="121" y="152" width="124" height="52" rx="10" fill="#141d33" stroke="#e8a33d" stroke-width="2"/>  <text x="183" y="173" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Repeat</text>  <text x="183" y="191" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">next loop</text></svg>
