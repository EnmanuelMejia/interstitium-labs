<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img">
  <title>Esoteric traditions: eight currents</title>
  <desc>Eight currents of Western esotericism: Kabbalah, Hermeticism, alchemy, astrology, tarot, Rosicrucianism, Theosophy, and Enochian magic.</desc>
  <defs><marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7d8fb0"/></marker></defs>
  <rect x="0" y="0" width="600" height="400" fill="#0b1220"/>
  <text x="28" y="34" font-family="sans-serif" font-size="19" font-weight="700" fill="#f2f6fc">Esoteric traditions: eight currents</text>  <text x="28" y="54" font-family="sans-serif" font-size="11" fill="#7f93b3" letter-spacing="2">OCCULT ESOTERIC</text>  <line x1="300" y1="212" x2="300" y2="94" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="441" y2="128" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="500" y2="212" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="441" y2="295" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="300" y2="330" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="158" y2="295" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="100" y2="212" stroke="#55688c" stroke-width="1.5"/>  <line x1="300" y1="212" x2="158" y2="128" stroke="#55688c" stroke-width="1.5"/>  <rect x="215" y="182" width="170" height="60" rx="10" fill="#141d33" stroke="#e5484d" stroke-width="2"/>  <text x="300" y="207" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="700" fill="#eef3fa">Esoteric</text>  <text x="300" y="225" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">traditions</text>  <rect x="236" y="70" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="300" y="89" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Kabbalah</text>  <text x="300" y="107" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">tree of life</text>  <rect x="377" y="104" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="441" y="123" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Hermeticism</text>  <text x="441" y="141" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">corpus</text>  <rect x="436" y="188" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="500" y="207" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Alchemy</text>  <text x="500" y="225" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">transmutation</text>  <rect x="377" y="271" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="441" y="290" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Astrology</text>  <text x="441" y="308" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">celestial</text>  <rect x="236" y="306" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="300" y="325" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Tarot</text>  <text x="300" y="343" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">arcana</text>  <rect x="94" y="271" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="158" y="290" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Rosicrucian</text>  <text x="158" y="308" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">manifestos</text>  <rect x="36" y="188" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="100" y="207" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Theosophy</text>  <text x="100" y="225" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">wisdom</text>  <rect x="94" y="104" width="128" height="48" rx="10" fill="#141d33" stroke="#3f587e" stroke-width="2"/>  <text x="158" y="123" text-anchor="middle" font-family="sans-serif" font-size="11.5" font-weight="700" fill="#eef3fa">Enochian</text>  <text x="158" y="141" text-anchor="middle" font-family="sans-serif" font-size="10.5" fill="#9fb0c8">angelic</text></svg>
