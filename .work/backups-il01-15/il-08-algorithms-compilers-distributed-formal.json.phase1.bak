 "scriptLabs": [
  {
   "id": "il08-lab-induction",
   "title": "Induction Proof Workshop",
   "brief": "Write complete induction proofs for three claims: sum of odds, Bernoulli's inequality, and the loop invariant of binary search. The required fragments force the proof skeleton.",
   "starter": "# For each claim, write: BASE, HYPOTHESIS, STEP.\n# 1. sum_{i=1..n} (2i-1) = n^2\n# 2. (1+x)^n >= 1+nx for x > -1 (Bernoulli)\n# 3. Binary search loop invariant: if key in a[0..n), key in a[lo..hi)",
   "required": [
    "BASE",
    "HYPOTHESIS",
    "STEP",
    "invariant"
   ],
   "hint": "Bernoulli step: (1+x)^(k+1) = (1+x)^k(1+x) >= (1+kx)(1+x) = 1+(k+1)x+kx² >= 1+(k+1)x. Binary search: invariant preserved by halving.",
   "solution": "# 1. Sum of odds\n# BASE: n=1: 1 = 1^2. HYPOTHESIS: sum to k = k^2.\n# STEP: sum to k+1 = k^2 + (2(k+1)-1) = k^2+2k+1 = (k+1)^2. QED.\n# 2. Bernoulli: BASE n=0: 1>=1. HYPOTHESIS: (1+x)^k >= 1+kx.\n# STEP: (1+x)^(k+1)=(1+x)^k(1+x) >= (1+kx)(1+x) = 1+(k+1)x+kx^2 >= 1+(k+1)x. QED.\n# 3. Binary search invariant: key in a[lo..hi) initially (lo=0,hi=n).\n# STEP: mid=(lo+hi)//2; if a[mid]==key done; if key<a[mid] hi=mid else lo=mid+1.\n# Invariant preserved: key (if present) stays in [lo,hi). Termination: hi-lo shrinks.\n# QED: loop exits with key found or lo==hi (absent)."
  },
  {
   "id": "il08-lab-malloc",
   "title": "A Tiny Allocator (15-213 Spirit)",
   "brief": "Implement a bump allocator with free-list reuse in Python (simulating the malloc lab): malloc(size), free(ptr), with first-fit search and coalescing. The 15-213 lesson in miniature.",
   "starter": "class MiniHeap:\n    def __init__(self, size=1024):\n        self.mem = bytearray(size)\n        self.free_list = [(0, size)]  # (offset, length)\n    def malloc(self, n):\n        # TODO: first-fit, split block, return offset or None\n        pass\n    def free(self, off, n):\n        # TODO: return block, coalesce neighbors\n        pass",
   "required": [
    "free_list",
    "coalesce",
    "first-fit",
    "split"
   ],
   "hint": "malloc: scan free_list for length>=n; split remainder back. free: insert sorted, merge with adjacent (coalesce). Track allocations in a dict for the demo.",
   "solution": "class MiniHeap:\n    def __init__(self, size=1024):\n        self.mem = bytearray(size)\n        self.free_list = [(0, size)]\n        self.allocd = {}\n    def malloc(self, n):\n        for i, (off, ln) in enumerate(self.free_list):\n            if ln >= n:  # first-fit\n                self.allocd[off] = n\n                if ln == n:\n                    self.free_list.pop(i)\n                else:  # split: carve n, leave remainder\n                    self.free_list[i] = (off+n, ln-n)\n                return off\n        return None\n    def free(self, off):\n        n = self.allocd.pop(off)\n        self.free_list.append((off, n))\n        self.free_list.sort()\n        # coalesce adjacent\n        merged = [self.free_list[0]]\n        for o, l in self.free_list[1:]:\n            po, pl = merged[-1]\n            if po+pl == o:\n                merged[-1] = (po, pl+l)\n            else:\n                merged.append((o, l))\n        self.free_list = merged\n\nh = MiniHeap(64)\na, b, c = h.malloc(16), h.malloc(16), h.malloc(16)\nh.free(b)          # hole in the middle\nd = h.malloc(8)    # first-fit reuses the hole, splits remainder\nprint('free_list:', h.free_list)  # coalescing visible\n# Lesson: fragmentation is the enemy; coalescing is the defense."
  },
  {
   "id": "il08-lab-bfs",
   "title": "BFS: Shortest Path, Proved",
   "brief": "Implement BFS returning shortest-path distances, then state the invariant that proves correctness. Code + proof — the 15-251 way.",
   "starter": "from collections import deque\n\ndef bfs(graph, s):\n    # TODO: dist dict, queue; invariant: when v dequeued, dist[v] is shortest\n    pass\n\n# graph as adjacency lists; test on a small graph; print distances",
   "required": [
    "deque",
    "dist[",
    "popleft",
    "invariant"
   ],
   "hint": "dist[s]=0; on dequeue v, for each neighbor w unvisited: dist[w]=dist[v]+1, enqueue. Invariant: queue holds vertices in nondecreasing dist — the proof of shortest-first.",
   "solution": "from collections import deque\n\ndef bfs(graph, s):\n    dist = {s: 0}\n    q = deque([s])\n    while q:\n        v = q.popleft()\n        # INVARIANT: vertices leave the queue in nondecreasing dist order,\n        # so the first time we set dist[w], it is the shortest path length.\n        for w in graph.get(v, []):\n            if w not in dist:\n                dist[w] = dist[v] + 1\n                q.append(w)\n    return dist\n\ng = {'a': ['b','c'], 'b': ['d'], 'c': ['d'], 'd': []}\nprint(bfs(g, 'a'))  # {'a':0,'b':1,'c':1,'d':2}\n# Proof sketch: BFS explores in waves; wave k = distance k. First visit is shortest."
  }
 ],
