 "scenarios": [
  {
   "id": "il08-scn-algo-choice",
   "title": "Choosing the Algorithm",
   "context": "You need the median of 10M numbers, memory for the full array, one pass preferred.",
   "steps": [
    {
     "prompt": "Algorithm?",
     "options": [
      {
       "text": "Quickselect (Hoare's selection) — expected O(n)",
       "correct": true,
       "why": "Selection doesn't need sorting — quickselect finds the kth element in expected linear time."
      },
      {
       "text": "Sort then index — O(n log n)",
       "correct": false,
       "why": "Correct but wasteful — sorting does work selection doesn't need."
      },
      {
       "text": "Heap of size n/2",
       "correct": false,
       "why": "O(n log n) with worse constants — quickselect dominates."
      }
     ]
    },
    {
     "prompt": "Adversarial input suspected. Harden?",
     "options": [
      {
       "text": "Randomized pivot (or median-of-medians for worst-case guarantee)",
       "correct": true,
       "why": "Randomization defeats adversarial order; median-of-medians gives deterministic O(n)."
      },
      {
       "text": "Bigger server",
       "correct": false,
       "why": "Hardware doesn't fix quadratic worst cases."
      }
     ]
    }
   ]
  },
  {
   "id": "il08-scn-distributed",
   "title": "The Counter Must Agree",
   "context": "Three replicas count ad impressions. Network partitions happen. The business needs the total.",
   "steps": [
    {
     "prompt": "Consistency choice?",
     "options": [
      {
       "text": "Strong consistency (Raft) — every increment agreed",
       "correct": false,
       "why": "Correct but slow/expensive for a counter — and partitions block progress."
      },
      {
       "text": "CRDT counter (G-Counter) — mergeable, available under partition",
       "correct": true,
       "why": "Counters are the CRDT success story: increments commute, merge is exact, partitions don't block."
      }
     ]
    },
    {
     "prompt": "Why does the CRDT work here?",
     "options": [
      {
       "text": "Magic",
       "correct": false,
       "why": "No magic — mathematics."
      },
      {
       "text": "Increments commute and merge is idempotent — the operation's algebra fits the data type",
       "correct": true,
       "why": "CRDTs work when operations commute; counting is the canonical case."
      }
     ]
    }
   ]
  }
 ],
