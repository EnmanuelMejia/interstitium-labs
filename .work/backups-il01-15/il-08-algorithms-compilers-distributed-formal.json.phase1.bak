    {
     "cmd": "goal \"sum(1..n) = n(n+1)/2\"",
     "out": "Goal 1: ∀n. sum(1..n) = n(n+1)/2"
    },
    {
     "cmd": "induction n",
     "out": "2 subgoals: [base] n=0 · [step] n → n+1"
    },
    {
     "cmd": "base",
     "out": "[base] sum(1..0) = 0 = 0·1/2 ✓"
    },
    {
     "cmd": "step",
     "out": "[step] IH: sum(1..n)=n(n+1)/2 ⊢ sum(1..n+1)=(n+1)(n+2)/2 ✓ by algebra"
    },
    {
     "cmd": "qed",
     "out": "Q.E.D. — proof complete, 4 tactics."
    },
    {
     "cmd": "sat \"(p -> q) /\\ p\"",
     "out": "SAT: model {p=true, q=true}"
    },
    {
     "cmd": "sat \"(p /\\ ~p)\"",
     "out": "UNSAT: no model — contradiction."
    },
    {
     "cmd": "help",
     "out": "commands: goal \"...\", induction <var>, base, step, qed, sat \"<formula>\""
    }
   ]
  }
 ],
 "timeFormula": "estimatedMinutes per module = 60 (orientation) + 15/note + 2/card + 3/quiz item + 10/drill item + 60 (hands-on lab), rounded to 5; course hours = rounded sum of module minutes."
