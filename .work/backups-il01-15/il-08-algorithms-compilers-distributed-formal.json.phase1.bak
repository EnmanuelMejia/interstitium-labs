   "id": "il08-m11",
   "type": "code",
   "prompt": "Write the induction step for: sum_{i=1}^{k+1}(2i-1) = (k+1)² given hypothesis for k.",
   "starter": "# HYPOTHESIS: sum to k = k^2\n# STEP:",
   "required": [
    "k^2",
    "2(k+1)-1",
    "(k+1)^2"
   ],
   "answer": "# HYPOTHESIS: sum_{i=1..k}(2i-1) = k^2\n# STEP: sum to k+1 = [sum to k] + (2(k+1)-1) = k^2 + 2k+1 = (k+1)^2. QED.",
   "explain": "Add the (k+1)th odd term to the hypothesis; algebra closes it."
  },
  {
   "id": "il08-m12",
   "type": "code",
   "prompt": "BFS: complete the neighbor-relaxation lines.",
   "starter": "from collections import deque\ndef bfs(g, s):\n    dist = {s: 0}; q = deque([s])\n    while q:\n        v = q.popleft()\n        for w in g.get(v, []):\n            # TODO: if unvisited, set dist and enqueue\n    return dist",
   "required": [
    "not in dist",
    "dist[v] + 1",
    "append"
   ],
   "answer": "from collections import deque\ndef bfs(g, s):\n    dist = {s: 0}; q = deque([s])\n    while q:\n        v = q.popleft()\n        for w in g.get(v, []):\n            if w not in dist:\n                dist[w] = dist[v] + 1\n                q.append(w)\n    return dist",
   "explain": "First visit sets the shortest distance — the BFS invariant."
  }
