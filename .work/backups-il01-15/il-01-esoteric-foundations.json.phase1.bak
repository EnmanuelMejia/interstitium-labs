   "handsOnLab": {
    "id": "il01-ccru-seminar--lab",
    "title": "Source-tiering dossier: The CCRU Seminar: Hyperstition and Cybernetics",
    "brief": "You will build a tiered evidence dossier for The CCRU Seminar: Hyperstition and Cybernetics: selecting claims from the module, assigning each an explicit epistemic tier, and grounding every tier in primary sources. This turns passive reading into scholarly practice.",
    "steps": [
     "Select three substantive claims from this module's notes on The CCRU Seminar: Hyperstition and Cybernetics.",
     "For each claim, locate the primary source it rests on (the actual text, in translation if needed) and record the exact passage.",
     "Assign each claim a tier: DOCUMENTED, SCHOLARLY CONSENSUS, TRADITIONAL, or CONTESTED — with a one-paragraph justification for the tier.",
     "Find one credible source that disagrees with or complicates each claim; summarize the counter-position fairly.",
     "Write a 400-word synthesis: what survives tiering, what doesn't, and what remains genuinely unknown.",
     "Peer-review your own dossier after 48 hours: flag every place where belief crept past evidence and correct it."
    ],
    "deliverable": "tiering-dossier.md containing the three tiered claims with primary-source passages, counter-positions, and the synthesis — every claim tiered, every tier justified.",
