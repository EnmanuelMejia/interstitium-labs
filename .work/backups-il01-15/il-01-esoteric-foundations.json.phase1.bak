   },
   "estimatedMinutes": 345
  }
 ],
 "scriptLabs": [
  {
   "id": "il01-lab-tier",
   "title": "The Tiering Engine",
   "brief": "Build a claim-tiering function: given a claim about an esoteric text, classify it DOCUMENTED / SCHOLARLY CONSENSUS / TRADITIONAL / CONTESTED with a justification. The method as code.",
   "starter": "def tier_claim(claim, evidence):\n    # YOUR TASK: return (tier, justification)\n    # DOCUMENTED: primary source / artifact / date\n    # SCHOLARLY CONSENSUS: historians agree (cite)\n    # TRADITIONAL: lineage claims it\n    # CONTESTED: open debate\n    pass\n\ntests = [\n    ('The Corpus Hermeticum manuscripts date to late antiquity', 'Casaubon 1614 philology; manuscript tradition'),\n    ('The Golden Dawn was founded by ancient adepts', 'lineage origin story; Cipher MS debate'),\n    ('Dee kept angel diaries 1581-1589', 'the diaries exist in archives'),\n]\nfor claim, ev in tests:\n    print(tier_claim(claim, ev))",
   "required": [
    "def tier_claim",
    "return",
    "for ",
    "print"
   ],
   "hint": "Keyword routing: 'manuscript/archive/exists' → DOCUMENTED; 'lineage claims/origin story' → TRADITIONAL (or CONTESTED if debated); 'historians agree' → SCHOLARLY CONSENSUS.",
   "solution": "def tier_claim(claim, evidence):\n    ev = evidence.lower()\n    if any(k in ev for k in ('manuscript', 'archive', 'exists', 'dated', 'philology')):\n        return ('DOCUMENTED', f'primary/artifact evidence: {evidence}')\n    if 'historians agree' in ev or 'consensus' in ev:\n        return ('SCHOLARLY CONSENSUS', f'cited agreement: {evidence}')\n    if 'lineage' in ev or 'origin story' in ev:\n        tier = 'CONTESTED' if 'debat' in ev else 'TRADITIONAL'\n        return (tier, f'lineage claim, honestly labeled: {evidence}')\n    return ('CONTESTED', f'open question: {evidence}')\n\ntests = [\n    ('The Corpus Hermeticum manuscripts date to late antiquity', 'Casaubon 1614 philology; manuscript tradition'),\n    ('The Golden Dawn was founded by ancient adepts', 'lineage origin story; Cipher MS debate'),\n    ('Dee kept angel diaries 1581-1589', 'the diaries exist in archives'),\n]\nfor claim, ev in tests:\n    print(tier_claim(claim, ev))\n# Lesson: tier each claim separately — the reflex, automated."
  },
  {
   "id": "il01-lab-corpus",
   "title": "Corpus Concordance Builder",
   "brief": "Build a tiny concordance: index key terms across three Hermetic passages, then report which terms co-occur. Textual analysis, the old-fashioned way, with code.",
   "starter": "passages = {\n    'asclepius': 'god is the glory of all things and the divine is the principle of all that is',\n    'poimandres': 'the light was the mind of god and the mind encompassed all things',\n    'emerald': 'as above so below and as below so above for the miracle of the one thing',\n}\n# YOUR TASK: for each passage, set of significant words (len>3, not stopwords)\n# YOUR TASK: print pairwise intersections (shared vocabulary)",
   "required": [
    "def ",
    "set(",
    "& ",
    "print"
   ],
   "hint": "stopwords={'the','and','for','was','all','are','that','with'}. sig(p)={w for w in p.split() if len(w)>3 and w not in stopwords}.",
   "solution": "stopwords={'the','and','for','was','all','are','that','with','from','his'}\npassages = {\n    'asclepius': 'god is the glory of all things and the divine is the principle of all that is',\n    'poimandres': 'the light was the mind of god and the mind encompassed all things',\n    'emerald': 'as above so below and as below so above for the miracle of the one thing',\n}\ndef sig(p):\n    return {w.strip('.,;:') for w in p.lower().split() if len(w)>3 and w not in stopwords}\nidx={k:sig(v) for k,v in passages.items()}\nkeys=list(idx)\nfor i in range(len(keys)):\n    for j in range(i+1,len(keys)):\n        shared=idx[keys[i]]&idx[keys[j]]\n        print(f'{keys[i]} x {keys[j]}: {sorted(shared)}')\n# Lesson: shared vocabulary maps the current — concordance before commentary."
  },
  {
   "id": "il01-lab-numogram",
   "title": "The Numogram Walker",
   "brief": "Model the numogram's decimal zone as a graph: digits 0-9 with the syzygy pairings as edges. Walk it, find cycles. Reading a diagram as data.",
   "starter": "# syzygy pairings (documented structure of the diagram)\npairs = [(0,9),(1,8),(2,7),(3,6),(4,5)]\n# YOUR TASK: build adjacency for digits 0-9: each digit connects to its pair AND to (d+1)%10 (the decimal circuit)\n# YOUR TASK: BFS from 0; print distances. Find: does every digit reach every other?",
   "required": [
    "def ",
    "for ",
    "% 10",
    "print"
   ],
   "hint": "adj[d] = {pair[d], (d+1)%10, (d-1)%10}. BFS with a deque or list-queue.",
   "solution": "pairs=[(0,9),(1,8),(2,7),(3,6),(4,5)]\npartner={}\nfor a,b in pairs: partner[a]=b; partner[b]=a\ndef neighbors(d): return {partner[d],(d+1)%10,(d-1)%10}\nseen={0:0}; queue=[0]\nwhile queue:\n    d=queue.pop(0)\n    for n in neighbors(d):\n        if n not in seen: seen[n]=seen[d]+1; queue.append(n)\nprint('distances from 0:',seen)\nprint('connected:', len(seen)==10)\n# Lesson: the diagram as data — structure you can walk beats structure you admire."
  }
 ],
