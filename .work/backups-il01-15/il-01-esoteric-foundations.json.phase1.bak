 "cheatSheets": [
  {
   "title": "IL-01 Epistemic Tiers Quick Reference",
   "blocks": [
    {
     "h": "DOCUMENTED",
     "body": "Primary sources, artifacts, dated texts — the bedrock."
    },
    {
     "h": "SCHOLARLY CONSENSUS",
     "body": "What historians agree on — provisional, cited."
    },
    {
     "h": "TRADITIONAL",
     "body": "Lineage claims — reported, not endorsed."
    },
    {
     "h": "CONTESTED",
     "body": "Open questions, rival readings — where the seminar lives."
    }
   ]
  },
