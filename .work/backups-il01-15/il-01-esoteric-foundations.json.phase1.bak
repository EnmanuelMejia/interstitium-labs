   "handsOnLab": {
    "id": "il01-hermetic-foundations--lab",
    "title": "Source-tiering dossier: Hermetic Foundations",
    "brief": "You will build a tiered evidence dossier for Hermetic Foundations: selecting claims from the module, assigning each an explicit epistemic tier, and grounding every tier in primary sources. This turns passive reading into scholarly practice.",
