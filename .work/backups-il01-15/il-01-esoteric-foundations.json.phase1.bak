 "honestyNote": "Original study material only — questions, labs, and scenarios are authored for this course. Interstitium Labs confers no certificate and is not affiliated with any esoteric order or academic institution. Tier labels reflect the course's historiographic method; contested topics are presented as contested. No belief is required or tested.",
 "terminalSims": [
  {
   "id": "il01-tiering-terminal",
   "title": "The Tiering Terminal",
   "brief": "Practice the tier discipline at the command line — query the academy’s tiers, dates, and figures. Every answer restates this course’s own material.",
   "prompt": "learner@il:tier$",
   "commands": [
    {
     "cmd": "help",
     "out": "commands: tiers | corpus | casaubon | dee | monas | cybersyn | hyperstition | journal | honesty"
    },
    {
     "cmd": "tiers",
     "out": "DOCUMENTED — primary sources, artifacts, dated texts. | SCHOLARLY CONSENSUS — what historians agree on, provisional and cited. | TRADITIONAL — what lineages claim about themselves, reported not endorsed. | CONTESTED — open questions and rival readings."
    },
    {
     "cmd": "corpus",
     "out": "Corpus Hermeticum + Asclepius: late-antique Alexandrian dialogues attributed to Hermes Trismegistus. Read the Asclepius first — the most complete single text."
    },
