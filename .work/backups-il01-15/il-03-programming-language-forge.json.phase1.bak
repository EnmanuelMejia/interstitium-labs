 "terminalSims": [
  {
   "id": "il03-term-git",
   "title": "Git Rescue Simulator",
   "brief": "Canned git scenarios: detached HEAD, merge conflict markers, accidental commit to main. Exact-match commands with fuzzy 'did you mean' — practice the rescue before you need it.",
   "prompt": "il03$ ",
   "commands": [
    {
     "cmd": "git status",
     "out": "On branch main\nnothing to commit, working tree clean"
    },
    {
     "cmd": "git log --oneline -3",
     "out": "a1b2c3d Add dashboard endpoint\n e4f5g6h Fix parser off-by-one\n 7890abc Initial commit"
    },
    {
     "cmd": "git checkout -b fix/parser",
     "out": "Switched to a new branch 'fix/parser'"
    },
    {
     "cmd": "git stash",
     "out": "Saved working directory and index state WIP on main: a1b2c3d"
    },
    {
     "cmd": "help",
     "out": "Available: git status, git log --oneline -3, git checkout -b fix/parser, git stash"
    }
   ]
  }
 ],
