 "scenarios": [
  {
   "id": "il03-scn-language",
   "title": "Choosing the Language for the Job",
   "context": "You need: a CLI tool parsing 10GB of logs fast, and a web dashboard for the results. One language or two?",
   "steps": [
    {
     "prompt": "The log parser?",
     "options": [
      {
       "text": "C++ or Rust-class systems language — throughput is the requirement",
       "correct": true,
       "why": "10GB parsing is throughput-bound; zero-cost abstraction and memory control win. Python would work but 10-50x slower."
      },
      {
       "text": "Python — fastest to write",
       "correct": false,
       "why": "Write-speed doesn't matter if runtime misses the SLA — and the dashboard needs the data on time."
      }
     ]
    },
    {
     "prompt": "The dashboard?",
     "options": [
      {
       "text": "Python (Flask/FastAPI) or JS — ecosystem speed for CRUD + charts",
       "correct": true,
       "why": "Dashboards are I/O-bound glue — the ecosystem (ORMs, chart libs, auth) matters more than raw speed."
      },
      {
       "text": "Same C++ binary serving HTTP",
       "correct": false,
       "why": "Possible, miserable: you'd hand-roll what web frameworks give for free. Instruments, not identities."
      }
     ]
    }
   ]
  },
  {
   "id": "il03-scn-index",
   "title": "The Slow Query",
   "context": "A dashboard query on orders (10M rows) takes 14s. EXPLAIN shows a full table scan on WHERE customer_id = ? AND status = ?.",
   "steps": [
    {
     "prompt": "First move?",
     "options": [
      {
       "text": "Add a composite index on (customer_id, status)",
       "correct": true,
       "why": "The query filters on both columns — a composite index serves the WHERE directly. Verify with EXPLAIN after."
      },
      {
       "text": "Add more RAM to the database server",
       "correct": false,
       "why": "Hardware masks the problem at 10M rows and bankrupts you at 100M. Fix the access path first."
      },
      {
       "text": "Cache the whole table in Redis",
       "correct": false,
       "why": "Caching helps repeated identical queries but the scan still happens on miss — and invalidation becomes your new problem."
      }
     ]
    },
    {
     "prompt": "After the index, it's 40ms. What do you document?",
     "options": [
      {
       "text": "The index definition, the before/after EXPLAIN, and the write-cost trade-off",
       "correct": true,
       "why": "Indexes cost on every write — the decision record lets the next engineer reason about it."
      },
      {
       "text": "Nothing — it works now",
       "correct": false,
       "why": "Undocumented performance fixes get reverted by the next migration. The lab notebook habit applies to production too."
      }
     ]
    }
   ]
  },
  {
   "id": "il03-scn-ub",
   "title": "The UB Hunt",
   "context": "Code review on a C++ PR. Three suspicious lines: `int a[2]; a[2] = 5;`, a cache that reads a pointer after `delete`, and `x++ + ++x` inside a macro.",
   "steps": [
    {
     "prompt": "First red flag — the array write?",
     "options": [
      {
       "text": "Out-of-bounds write: undefined behavior, full stop",
       "correct": true,
       "why": "a[2] on int a[2] is out of bounds — the standard defines nothing past the last element, so the compiler may do anything."
      },
      {
       "text": "It compiles, so it's fine",
       "correct": false,
       "why": "Compiling is not a safety proof — UB compiles silently and detonates at -O2."
      },
      {
       "text": "A style issue, not a bug",
       "correct": false,
       "why": "Style issues don't let the optimizer delete your security check. UB does."
      }
     ]
    },
    {
     "prompt": "The cache reads a pointer after delete. The fix?",
     "options": [
      {
       "text": "Transfer ownership with unique_ptr — no raw owning pointers",
       "correct": true,
       "why": "RAII: the lifetime is tied to scope, so use-after-free becomes unrepresentable. This is the Module 1 discipline."
      },
      {
       "text": "Keep the raw pointer and add a comment",
       "correct": false,
       "why": "Comments don't run. The next edit reintroduces the bug the comment describes."
      },
      {
       "text": "It works in practice on this compiler",
       "correct": false,
       "why": "'Works in practice' is UB's native camouflage — it works until the optimizer, the platform, or Tuesday changes."
      }
     ]
    },
    {
     "prompt": "`x++ + ++x` — the verdict?",
     "options": [
      {
       "text": "Undefined behavior: unsequenced modifications of x",
       "correct": true,
       "why": "Two side effects on x unsequenced relative to each other — the standard imposes no order, so the result is UB, not 'implementation-defined'."
      },
      {
       "text": "Defined: evaluates left to right",
       "correct": false,
       "why": "C++ does not evaluate operands left to right in general — that assumption is the bug."
      },
      {
       "text": "Implementation-defined but safe",
       "correct": false,
       "why": "Implementation-defined still constrains the implementation. This is undefined: no constraints at all."
      }
     ]
    }
   ]
  },
  {
   "id": "il03-scn-race",
   "title": "The Flaky Test",
   "context": "A counter test passes 19 of 20 runs. The 20th prints 999983 instead of 1000000. Threads: 4. Increments per thread: 250000.",
   "steps": [
    {
     "prompt": "Diagnosis?",
     "options": [
      {
       "text": "Race on read-modify-write: counter += 1 is LOAD, ADD, STORE — interleavings lose updates",
       "correct": true,
       "why": "Three bytecodes, four threads, no synchronization: lost updates are expected, not mysterious. (Module 1, Concepts: race condition.)"
      },
      {
       "text": "Bad RNG seed in the test harness",
       "correct": false,
       "why": "There's no RNG here — don't invent a cause when the interleaving explains the exact shortfall."
      },
      {
       "text": "Hardware fault — replace the machine",
       "correct": false,
       "why": "Blaming hardware for a textbook race is how flaky tests become permanent residents."
      }
     ]
    },
    {
     "prompt": "Before you fix it — first move?",
     "options": [
      {
       "text": "Reproduce it reliably first — a fix for a bug you can't reproduce is a guess",
       "correct": true,
       "why": "The forge's lab rule: produce the race on demand (more threads, more iterations), then fix. Reproduction is the diagnosis."
      },
      {
       "text": "Add a mutex immediately",
       "correct": false,
       "why": "A mutex probably fixes it — but 'probably' is not a diagnosis, and you'll never know if you fixed the real race."
      },
      {
       "text": "Increase the thread count to drown it out",
       "correct": false,
       "why": "More threads make the race likelier, not fixed — that's a reproduction aid, not a repair."
      }
     ]
    },
    {
     "prompt": "The honest fix, per the module?",
     "options": [
      {
       "text": "Guard the critical section with a mutex (or an atomic counter)",
       "correct": true,
       "why": "Mutual exclusion makes the read-modify-write atomic; std::atomic makes the counter itself race-free. Either closes the interleaving."
      },
      {
       "text": "Insert sleep() between increments",
       "correct": false,
       "why": "Sleep narrows the race window — it doesn't close it. The 21st run fails at 3 AM."
      },
      {
       "text": "Mark the counter volatile",
       "correct": false,
       "why": "volatile stops some optimizations; it provides no atomicity and no memory ordering. It is not synchronization."
      }
     ]
    }
   ]
  },
  {
   "id": "il03-scn-api",
   "title": "The Contract Break",
   "context": "Your v1 API renames `user_name` to `userName`. Mobile clients — which you don't control — start crashing on the missing field.",
   "steps": [
    {
     "prompt": "The contract violation?",
     "options": [
      {
       "text": "Renamed a field in a shipped version without versioning",
       "correct": true,
       "why": "The REST contract (Module 2, Concepts) is a promise to clients you didn't write: v1's shape is frozen the day it ships."
      },
      {
       "text": "Clients should have guessed the rename",
       "correct": false,
       "why": "Clients conform to the documented contract — mind-reading is not in the spec."
      },
      {
       "text": "JSON has no contract, so nothing broke",
       "correct": false,
       "why": "The crashes are the contract asserting itself. Undocumented promises are still promises."
      }
     ]
    },
    {
     "prompt": "The repair?",
     "options": [
      {
       "text": "Ship v2 with the new name; keep v1 stable and documented; announce a sunset",
       "correct": true,
       "why": "Version, don't mutate: old clients keep working, new clients opt in, and the sunset date makes the migration a plan instead of a surprise."
      },
      {
       "text": "Force-update all clients overnight",
       "correct": false,
       "why": "You don't control the clients — app-store review alone makes 'overnight' fiction."
      },
      {
       "text": "Rename it back silently and pretend nothing happened",
       "correct": false,
       "why": "Silent reverts corrupt every client's mental model and your changelog's credibility at once."
      }
     ]
    }
   ]
  },
  {
   "id": "il03-scn-packer",
   "title": "The Muddy Render",
   "context": "Your circle study renders muddy: translucent circles stacked into brown smears, and everything clumps in one corner of the canvas.",
   "steps": [
    {
     "prompt": "First diagnosis — the clumping?",
     "options": [
      {
       "text": "No minimum-distance enforcement — pure rejection sampling clumps",
       "correct": true,
       "why": "Rejection sampling places circles anywhere they fit; without a spacing rule they pile where they land. (Module 4, Concepts.)"
      },
      {
       "text": "Wrong seed",
       "correct": false,
       "why": "A seed changes which clumps you get, not whether clumping happens — the algorithm is the cause, not the seed."
      },
      {
       "text": "Alpha is too high",
       "correct": false,
       "why": "Alpha explains the mud, not the clumps. Diagnose one symptom at a time."
      }
     ]
    },
    {
     "prompt": "The structural fix for clumping?",
     "options": [
      {
       "text": "Poisson-disc sampling: enforce a minimum distance",
       "correct": true,
       "why": "Grid-accelerated dart throwing guarantees spacing — even coverage, no clumping, no voids. (Module 4, Hands-on procedure.)"
      },
      {
       "text": "Place more circles",
       "correct": false,
       "why": "More circles through a clumping sampler gives you denser clumps."
      },
      {
       "text": "Use a bigger canvas",
       "correct": false,
       "why": "A bigger canvas with the same sampler gives you the same clumps, farther apart."
      }
     ]
    },
    {
     "prompt": "And the muddiness?",
     "options": [
      {
       "text": "Lower Alpha and rethink the blend mode — layering is doing the damage",
       "correct": true,
       "why": "Stacked translucency converges to mud; Alpha controls the atmosphere and blend modes control how layers converse. (Module 4, Concepts.)"
      },
      {
       "text": "Raise NC for more colors",
       "correct": false,
       "why": "More hue voices over muddy layering gives you muddy rainbows."
      },
      {
       "text": "Change the seed and re-render",
       "correct": false,
       "why": "The seed is innocent — the layering math is the defendant."
      }
     ]
    }
   ]
  }
 ],
 "trainers": [
  {
   "id": "il03-trainer-bigo",
   "title": "Big-O Sprint Trainer",
