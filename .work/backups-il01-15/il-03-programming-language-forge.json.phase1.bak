  },
  {
   "id": "il03-dr-rest",
   "title": "API drill",
   "prompt": "PUT vs POST semantics?",
   "choices": [
    "identical",
    "PUT idempotent (same effect repeated); POST not necessarily",
    "POST idempotent",
    "neither is safe"
   ],
   "answer": 1,
   "explain": "PUT replaces the resource state — repeating it converges; POST typically creates anew."
  },
  {
   "id": "il03-dr-context",
   "title": "Context managers",
   "prompt": "The `with` block guarantees ___.",
   "choices": [
