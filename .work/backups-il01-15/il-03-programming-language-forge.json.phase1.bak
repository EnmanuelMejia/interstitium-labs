  },
  {
   "id": "il03-m18",
   "type": "choice",
   "q": "A stream pipeline with only intermediate ops (no terminal op) ___.",
   "choices": [
    "does nothing until a terminal op arrives",
    "runs immediately",
    "throws IllegalStateException",
    "buffers input forever"
   ],
   "answer": 0,
   "explain": "Streams are lazy: filter/map only describe the pipeline; collect/reduce/forEach executes it."
  },
  {
   "id": "il03-m19",
   "type": "choice",
   "q": "For `unique_ptr<Widget> a; auto b = std::move(a);` — afterwards, `a` is ___.",
   "choices": [
    "empty (null)",
    "an independent copy",
    "deleted",
    "shared with b"
   ],
   "answer": 0,
   "explain": "Move transfers ownership: b owns the Widget, a is left valid-but-empty. unique_ptr cannot be copied."
  },
  {
   "id": "il03-m20",
   "type": "choice",
   "q": "A class managing a resource with a custom destructor must also handle ___.",
   "choices": [
