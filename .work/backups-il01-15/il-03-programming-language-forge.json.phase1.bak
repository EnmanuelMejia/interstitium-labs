   "explain": "PECS: Producer Extends — ? extends T for reading."
  },
  {
   "id": "il03-dr-stream",
   "title": "Streams drill",
   "prompt": "When does filter() execute?",
   "choices": [
    "Immediately",
    "At the terminal operation",
    "At collect() only",
    "Never"
   ],
   "answer": 1,
   "explain": "Intermediate ops are lazy — execution happens at the terminal op (collect is one terminal op)."
  },
  {
   "id": "il03-dr-raii",
