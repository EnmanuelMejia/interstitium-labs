 "mockTasks": [
  {
   "id": "il03-m01",
   "type": "choice",
   "q": "Generator expressions are valuable because ___.",
   "choices": [
    "they're faster to type",
    "O(1) memory via laziness",
    "they parallelize",
    "they're newer"
   ],
   "answer": 1,
   "explain": "Laziness — items produced on demand, constant memory."
  },
  {
   "id": "il03-m02",
   "type": "choice",
   "q": "Java: ? super T is for ___.",
   "choices": [
    "reading",
    "writing (consumer)",
    "both",
    "neither"
   ],
   "answer": 1,
   "explain": "Consumer Super — safe to write T into the collection."
  },
  {
