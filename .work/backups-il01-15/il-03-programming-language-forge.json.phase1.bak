 "scriptLabs": [
  {
   "id": "il03-lab-generators",
   "title": "Lazy Pipeline: Generators vs Lists",
   "brief": "Build a data pipeline two ways — list-based and generator-based — and measure peak memory on a large input. The required fragments force the laziness comparison.",
   "starter": "import tracemalloc\n\ndef process_list(n):\n    # eager: build the whole list, then filter, then sum\n    pass\n\ndef process_gen(n):\n    # lazy: generator pipeline\n    pass\n\nfor fn in (process_list, process_gen):\n    tracemalloc.start()\n    fn(2_000_00)\n    print(fn.__name__, tracemalloc.get_traced_memory())\n    tracemalloc.stop()",
   "required": [
    "yield",
    "tracemalloc",
    "sum(",
    "for "
   ],
   "hint": "Generator version: sum(x*x for x in range(n) if x % 2). tracemalloc.get_traced_memory()[1] is peak.",
   "solution": "import tracemalloc\n\ndef process_list(n):\n    data = [x*x for x in range(n)]\n    return sum(x for x in data if x % 2)\n\ndef process_gen(n):\n    return sum(x*x for x in range(n) if (x*x) % 2)\n\n# Better: single lazy generator, no intermediate at all\ndef process_gen2(n):\n    def squares():\n        for x in range(n):\n            yield x * x\n    return sum(s for s in squares() if s % 2)\n\nfor fn in (process_list, process_gen2):\n    tracemalloc.start()\n    fn(200_000)\n    print(fn.__name__, 'peak bytes:', tracemalloc.get_traced_memory()[1])\n    tracemalloc.stop()"
  },
  {
   "id": "il03-lab-race",
   "title": "Race Laboratory: Produce It, Then Fix It",
   "brief": "Write a threaded counter increment that loses updates (the race), demonstrate the loss, then fix it with a lock. You must show the bug BEFORE the fix — a fix for an unreproduced bug is a guess.",
   "starter": "import threading\n\ncounter = 0\n\ndef work():\n    global counter\n    for _ in range(100_000):\n        counter += 1  # race here\n\nthreads = [threading.Thread(target=work) for _ in range(4)]\n[t.start() for t in threads]\n[t.join() for t in threads]\nprint('expected 400000, got', counter)\n# 1) run: observe the shortfall  2) fix with a lock  3) re-run: exact",
   "required": [
    "threading.Lock",
    "with ",
    "acquire",
    "counter += 1"
   ],
   "hint": "Wrap the increment: lock = threading.Lock(); with lock: counter += 1. The with-block is the critical section.",
   "solution": "import threading\n\ncounter = 0\nlock = threading.Lock()\n\ndef work():\n    global counter\n    for _ in range(100_000):\n        with lock:          # critical section: read-modify-write is atomic now\n            counter += 1\n\nthreads = [threading.Thread(target=work) for _ in range(4)]\n[t.start() for t in threads]\n[t.join() for t in threads]\nprint('expected 400000, got', counter)  # now exactly 400000\n# Lesson: counter += 1 is three bytecodes (LOAD, ADD, STORE) — threads interleave between them."
  },
  {
   "id": "il03-lab-bst",
   "title": "BST: Implement, Then Break, Then Balance-Talk",
   "brief": "Implement a binary search tree with insert and inorder traversal. Then insert sorted data and observe the degeneration — the lab's point is feeling why balanced trees exist.",
   "starter": "class Node:\n    def __init__(self, k):\n        self.k, self.l, self.r = k, None, None\n\ndef insert(root, k):\n    # recursive insert; return new root\n    pass\n\ndef inorder(root, out):\n    pass\n\n# 1) insert [5,3,7,1,9] -> inorder should be sorted\n# 2) insert range(1000) -> measure height: the degeneration",
   "required": [
    "class Node",
    "def insert",
    "def inorder",
    "append"
   ],
   "hint": "Height of degenerate sorted-insert tree = n-1. Inorder of a BST is always sorted — that's the invariant to test.",
   "solution": "class Node:\n    def __init__(self, k):\n        self.k, self.l, self.r = k, None, None\n\ndef insert(root, k):\n    if root is None:\n        return Node(k)\n    if k < root.k:\n        root.l = insert(root.l, k)\n    else:\n        root.r = insert(root.r, k)\n    return root\n\ndef inorder(root, out):\n    if root:\n        inorder(root.l, out)\n        out.append(root.k)\n        inorder(root.r, out)\n\ndef height(r):\n    return 0 if not r else 1 + max(height(r.l), height(r.r))\n\nroot = None\nfor k in [5,3,7,1,9]:\n    root = insert(root, k)\nout = []\ninorder(root, out)\nprint(out)  # [1, 3, 5, 7, 9] — sorted: the BST invariant\n\ndeg = None\nfor k in range(1000):\n    deg = insert(deg, k)\nprint('degenerate height:', height(deg))  # 1000 — a linked list. This is why AVL/red-black exist."
  }
 ],
 "drills": [
  {
   "id": "il03-dr-pecs",
   "title": "Generics drill",
