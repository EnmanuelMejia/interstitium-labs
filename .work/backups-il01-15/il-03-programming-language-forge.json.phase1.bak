  {
   "id": "il03-m13",
   "type": "code",
   "prompt": "Write a Python generator yielding squares of even numbers below n.",
   "starter": "def even_squares(n):\n    pass",
   "required": [
    "yield",
    "% 2",
    "range"
   ],
   "answer": "def even_squares(n):\n    for x in range(n):\n        if x % 2 == 0:\n            yield x * x",
   "explain": "Lazy generator: filter evens, yield squares — O(1) memory."
  },
  {
   "id": "il03-m14",
   "type": "code",
   "prompt": "SQL: customers with no orders over $100 (keep all customers).",
   "starter": "-- customers(id,name), orders(id,customer_id,total)\nSELECT c.name\nFROM customers c\n-- complete the join",
   "required": [
    "LEFT JOIN",
    "ON",
    "total > 100"
   ],
   "answer": "SELECT c.name FROM customers c LEFT JOIN orders o ON o.customer_id = c.id AND o.total > 100 WHERE o.id IS NULL;",
   "explain": "Filter in ON preserves the outer join; WHERE o.id IS NULL keeps only customers with no big orders."
  },
  {
   "id": "il03-m15",
   "type": "choice",
   "q": "The `with` block calls ___.",
   "choices": [
