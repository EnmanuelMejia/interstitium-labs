  "scriptLabs": [
    {
      "id": "il06-lab-recon",
      "title": "Recon Pipeline: Passive-First Scripting",
      "brief": "Build a passive recon script: given a domain, pull certificate transparency (crt.sh), DNS records, and WHOIS — no packets to the target. Required fragments enforce the passive discipline.",
      "starter": "#!/usr/bin/env python3\n\"\"\"Passive recon: crt.sh + DNS + WHOIS. No active scanning.\"\"\"\nimport json, subprocess, sys, urllib.request\n\ndomain = sys.argv[1]\n# TODO 1: crt.sh JSON for subdomains\n# TODO 2: DNS records via dig (A, MX, TXT)\n# TODO 3: WHOIS registrar + dates\n# print a findings report",
      "required": [
        "crt.sh",
        "urllib",
        "dig",
        "whois",
        "json"
      ],
      "hint": "crt.sh: https://crt.sh/?q=%.domain&output=json. dig +short. whois | grep -i registrar. All passive — nothing touches the target's ports.",
      "solution": "#!/usr/bin/env python3\n\"\"\"Passive recon: crt.sh + DNS + WHOIS. No active scanning.\"\"\"\nimport json, subprocess, sys, urllib.request\n\ndomain = sys.argv[1]\nprint(f'=== passive recon: {domain} ===')\n\n# 1. Certificate transparency: subdomains from public logs (fully passive)\nurl = f'https://crt.sh/?q=%.{domain}&output=json'\ntry:\n    data = json.load(urllib.request.urlopen(url, timeout=30))\n    subs = sorted({e['name_value'] for e in data})\n    print(f'--- crt.sh: {len(subs)} names ---')\n    print('\\n'.join(subs[:50]))\nexcept Exception as ex:\n    print('crt.sh failed:', ex)\n\n# 2. DNS via the resolver (not the target)\nfor rtype in ('A', 'MX', 'TXT', 'NS'):\n    out = subprocess.run(['dig', '+short', domain, rtype], capture_output=True, text=True)\n    print(f'--- DNS {rtype} ---\\n{out.stdout.strip() or \"(none)\"}')\n\n# 3. WHOIS: registrar and dates\nout = subprocess.run(['whois', domain], capture_output=True, text=True)\nfor line in out.stdout.splitlines():\n    if any(k in line.lower() for k in ('registrar:', 'creation date', 'expiry')):\n        print('WHOIS:', line.strip())\nprint('=== done: zero packets to target ports ===')"
    },
    {
      "id": "il06-lab-sigma",
      "title": "Sigma: Hunt Becomes Detection",
      "brief": "Write a Sigma rule detecting suspicious PowerShell (encoded commands / download cradles), with logsource, detection logic, and level. Then write the tuning note: what would false-positive and how you'd filter it.",
      "starter": "title: Suspicious PowerShell Encoded Command\n# TODO: id, status, description, logsource (windows, sysmon), detection (selection + filter + condition), level\n# TODO: falsepositives + a tuning filter",
      "required": [
        "title:",
        "logsource:",
        "detection:",
        "condition:",
        "level:",
        "falsepositives:"
      ],
      "hint": "selection: EventID 1 (Sysmon) or 4688; CommandLine contains '-EncodedCommand' or 'IEX' or 'DownloadString'. filter: known admin tools. condition: selection and not filter.",
      "solution": "title: Suspicious PowerShell Encoded Command\nid: 11111111-2222-3333-4444-555555555555\nstatus: test\ndescription: Detects PowerShell with -EncodedCommand or download cradles (IEX/DownloadString) - common attacker tradecraft.\nlogsource:\n  category: process_creation\n  product: windows\ndetection:\n  selection:\n    Image|endswith: '\\powershell.exe'\n    CommandLine|contains:\n      - '-EncodedCommand'\n      - '-enc '\n      - 'IEX'\n      - 'DownloadString'\n      - 'Invoke-Mimikatz'\n  filter_admin:\n    CommandLine|contains:\n      - 'SCCM_EncodedDeploy'   # known admin tooling marker\n  condition: selection and not filter_admin\nfalsepositives:\n  - Admin automation using encoded commands\n  - Software deployment tools\nlevel: high\n# TUNING NOTE: baseline for 2 weeks; allowlist the deployment tool's exact\n# command-line marker; escalate level to critical if paired with\n# network connection to rare external IP (correlation rule)."
    },
    {
      "id": "il06-lab-kql",
      "title": "KQL Hunt: Impossible Travel",
      "brief": "Write a KQL query finding impossible-travel logons: same user, two distant locations, within 60 minutes. Required fragments force the self-join pattern.",
      "starter": "// TODO: SigninLogs, two logons same user, different cities, < 60 min apart\n// HINT: join the table to itself on UserPrincipalName, filter time delta and location difference",
      "required": [
        "SigninLogs",
        "join",
        "UserPrincipalName",
        "datetime_diff",
        "City"
      ],
      "hint": "A=SigninLogs | where ResultType==0; B=A; A | join kind=inner (UserPrincipalName) B | where A.TimeGenerated < B.TimeGenerated and datetime_diff('minute', A.TimeGenerated, B.TimeGenerated) between (1..60) and A.LocationDetails.city != B.LocationDetails.city",
      "solution": "let window = 60; // minutes\nSigninLogs\n| where ResultType == 0  // successful logons only\n| project TimeGenerated, UserPrincipalName, City = LocationDetails.city, IPAddress\n| join kind=inner (\n    SigninLogs\n    | where ResultType == 0\n    | project TimeGenerated, UserPrincipalName, City = LocationDetails.city, IPAddress\n  ) on UserPrincipalName\n| where TimeGenerated < TimeGenerated1\n| where datetime_diff('minute', TimeGenerated, TimeGenerated1) between (1 .. window)\n| where City != City1\n| project UserPrincipalName, FirstCity=City, FirstTime=TimeGenerated, SecondCity=City1, SecondTime=TimeGenerated1,\n    MinutesApart=datetime_diff('minute', TimeGenerated, TimeGenerated1)\n| order by MinutesApart asc\n// Tune: allowlist VPN egress cities; alert on <30 min intercontinental pairs first."
    }
  ],
  "drills": [
    {
      "id": "il06-dr-recon",
      "title": "Recon drill",
      "prompt": "First recon step?",
