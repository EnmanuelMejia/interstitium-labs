      "answer": "import json, sys, urllib.request\ndomain = sys.argv[1]\nurl = f'https://crt.sh/?q=%.{domain}&output=json'\ndata = json.load(urllib.request.urlopen(url, timeout=30))\nfor n in sorted({e['name_value'] for e in data}):\n    print(n)",
