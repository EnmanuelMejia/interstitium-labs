  "scenarios": [
    {
      "id": "il06-scn-phish",
      "title": "The Phishing Wave",
      "context": "Monday 8 AM: 40 users report a credential-harvesting email. Three clicked.",
      "steps": [
        {
          "prompt": "First 15 minutes?",
          "options": [
            {
              "text": "Pull the email, extract URLs/attachments, hunt who clicked, force password resets + revoke sessions for clickers",
              "correct": true,
              "why": "Contain the credential compromise first: identify clickers, kill their sessions, reset — before the attacker uses them."
            },
            {
              "text": "Send an all-hands email",
              "correct": false,
              "why": "Communication matters but containment is first — the attacker is inside the 15-minute window."
            },
            {
              "text": "Block the sender domain only",
              "correct": false,
              "why": "One domain blocked; the campaign rotates in minutes. Hunt the clicks, not just the sender."
            }
          ]
        },
        {
          "prompt": "Clickers contained. Next?",
          "options": [
            {
              "text": "Search mail logs for all recipients, pull the payload, check for payload execution (EDR), hunt lateral movement",
              "correct": true,
              "why": "Scope the incident: everyone who got it, anyone who ran it, any movement. Then lessons-learned."
            },
            {
              "text": "Close the ticket",
              "correct": false,
              "why": "Containment isn't resolution — scope, eradicate, recover, learn."
            }
          ]
        }
      ]
    },
    {
      "id": "il06-scn-ad-path",
      "title": "BloodHound Finds a Path",
      "context": "BloodHound shows: helpdesk tier → local admin on workstation → DA in 3 hops via unconstrained delegation.",
      "steps": [
        {
          "prompt": "As the attacker (authorized test), you?",
          "options": [
            {
              "text": "Follow the shortest path: compromise the chain step by step, documenting each hop",
              "correct": true,
              "why": "Graph thinking: exploit the path, document each hop for the report — that's the finding."
            },
            {
              "text": "Attack the DC directly",
              "correct": false,
              "why": "Ignoring the path wastes the intel — the path IS the vulnerability."
            }
          ]
        },
        {
          "prompt": "As the defender reading this report, you fix?",
          "options": [
            {
              "text": "Remove unconstrained delegation, tier the admin model, monitor the path — fix the graph, not the host",
              "correct": true,
              "why": "The vulnerability is architectural — delegation + tiering flaws. Host fixes don't close graph paths."
            },
            {
              "text": "Reimage the workstation",
              "correct": false,
              "why": "Reimaging one node leaves the delegation path intact for the next workstation."
            }
          ]
        }
      ]
    }
  ],
