  "terminalSims": [
    {
      "id": "il06-recon-cli",
      "title": "Attacker Linux & Recon CLI simulator",
      "brief": "Practice the Module 1 command set — bash pipelines, scanning, passive recon — against the fictional lab target target.lab. All outputs are simulated practice data.",
      "prompt": "attacker@il:~$",
      "commands": [
        {
          "cmd": "pwd",
          "out": "/home/attacker"
        },
        {
          "cmd": "ls",
          "out": "findings.md  recon/  scans/  wordlists/"
        },
        {
          "cmd": "cat findings.md",
          "out": "target: target.lab (lab-owned)\npassive done: crt.sh names, DNS, WHOIS\nnext: SYN scan, then service detection"
        },
        {
          "cmd": "nmap -sS target.lab",
          "out": "Starting Nmap (simulated)\nPORT    STATE SERVICE\n22/tcp  open  ssh\n80/tcp  open  http\n443/tcp open  https\n445/tcp open  smb\nDone: 4 open ports (SYN scan, half-open)"
        },
        {
          "cmd": "nmap -sV target.lab",
          "out": "PORT    STATE SERVICE VERSION\n22/tcp  open  ssh     OpenSSH (lab build)\n80/tcp  open  http    nginx (lab build)\n443/tcp open  https   nginx (lab build)\n445/tcp open  smb     Samba (lab build)\nService detection performed. Report to findings.md."
        },
        {
          "cmd": "nmap -sU target.lab",
          "out": "PORT    STATE SERVICE\n53/udp  open  dns\n161/udp open  snmp\nUDP scan complete: slow, but UDP hides real vulnerabilities."
        },
        {
          "cmd": "dig target.lab +short",
          "out": "10.10.10.5"
        },
        {
          "cmd": "dig target.lab MX +short",
          "out": "10 mail.target.lab."
        },
        {
          "cmd": "whois target.lab",
          "out": "Domain: target.lab (LAB FIXTURE — simulated output)\nRegistrar: Example Lab Registrar\nCreated: 2026-01-01"
        },
        {
          "cmd": "nmap -sV target.lab | grep open",
          "out": "22/tcp  open  ssh     OpenSSH (lab build)\n80/tcp  open  http    nginx (lab build)\n443/tcp open  https   nginx (lab build)\n445/tcp open  smb     Samba (lab build)"
        },
        {
          "cmd": "nmap -sV target.lab | grep open | cut -d' ' -f1 | sort -u",
          "out": "22/tcp\n443/tcp\n445/tcp\n80/tcp"
        },
        {
          "cmd": "airodump-ng wlan0mon",
          "out": "BSSID              CH  ENC   ESSID\nAA:BB:CC:11:22:33  6   WPA2  LAB-AP (your own access point)\nCapturing handshakes on your own AP only."
        },
        {
          "cmd": "echo $SHELL",
          "out": "/bin/bash"
        },
        {
          "cmd": "sha256sum findings.md",
          "out": "9f2c...a41b  findings.md   (hash everything: chain of custody starts here)"
        }
      ]
    },
    {
      "id": "il06-kql-hunt",
      "title": "KQL Hunting simulator",
      "brief": "Practice Module 5 KQL hunt patterns — filter, aggregate, rank, time-bucket — against the fictional Sentinel workspace contoso-sec. All results are simulated practice data.",
      "prompt": "analyst@il:~$",
      "commands": [
        {
          "cmd": "SecurityEvent | where EventID == 4688 | summarize count() by Process | top 5 by count_",
          "out": "Process            count_\nconhost.exe        18412\nsvchost.exe        12004\npowershell.exe       312\ncmd.exe              188\nwmiprvse.exe          96"
        },
        {
          "cmd": "SecurityEvent | where Process has \"cmd.exe\" | summarize count() by ParentProcessName | top 10 by count_",
          "out": "ParentProcessName  count_\nexplorer.exe        141\npowershell.exe        32\nwinword.exe            3   <-- investigate: Office spawning shells\nwmiprvse.exe           2"
        },
        {
          "cmd": "SigninLogs | where ResultType == 0 | summarize count() by UserPrincipalName | top 5 by count_",
          "out": "UserPrincipalName        count_\nana@contoso-sec.lab      412\nben@contoso-sec.lab      388\nsvc-backup               96\nana@contoso-sec.lab ... impossible-travel candidate flagged in next hunt"
        },
        {
          "cmd": "SecurityEvent | where EventID == 4688 | summarize count() by bin(TimeGenerated, 1h)",
          "out": "TimeGenerated        count_\n2026-10-07T06:00Z    2104\n2026-10-07T07:00Z    2211\n2026-10-07T08:00Z    8931  <-- burst: investigate\n2026-10-07T09:00Z    2187"
        },
        {
          "cmd": "DeviceProcessEvents | where FileName == \"powershell.exe\" | where ProcessCommandLine contains \"-EncodedCommand\" | project TimeGenerated, DeviceName, AccountName",
          "out": "TimeGenerated        DeviceName   AccountName\n2026-10-07T08:14Z  WS-1142      TEMP\\jdoe\n2026-10-07T08:31Z  WS-1142      TEMP\\jdoe\nHypothesis confirmed: encoded PowerShell on WS-1142. Escalate to incident."
        }
      ]
    }
  ],
