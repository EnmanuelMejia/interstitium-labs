  "cheatSheets": [
    {
      "title": "IL-06 Offensive Quick Reference",
      "blocks": [
        {
          "h": "Methodology",
          "body": "Passive → active recon → enumerate deeply (70%) → exploit → privesc (SUID/cron/paths) → loot → document from minute one"
        },
        {
          "h": "AD chains",
          "body": "Kerberoasting (4769) · AS-REP roast (no pre-auth) · BloodHound shortest path · lateral (PSExec/WMI) · Golden Ticket/DCSync = domain dominance"
        },
        {
          "h": "Web",
          "body": "Burp: proxy→repeater→intruder · SQLi→RCE · SSRF→169.254.169.254 (IMDSv2 defends) · deserialization = RCE · race = TOCTOU"
        },
        {
          "h": "Ethics",
          "body": "Legal targets only · documented authorization · stay in scope · report with remediation · responsible disclosure"
        }
      ]
    },
    {
      "title": "IL-06 Defensive & Sentinel Quick Reference",
      "blocks": [
        {
          "h": "SOC",
          "body": "L1 triage (speed) → L2 correlate (depth) → L3 hunt (hypotheses) · contain before eradicate · memory before disk"
        },
        {
          "h": "Detection",
          "body": "Sigma: title/logsource/detection/level · hunts become rules · tune FPs, don't tolerate · ATT&CK maps the gaps"
        },
        {
          "h": "IR",
          "body": "Prepare → detect → contain → eradicate → recover → lessons-learned · chain of custody: hash + document · blameless postmortems"
        },
        {
          "h": "KQL/Sentinel",
          "body": "Hypothesis first · join for impossible travel · connectors before rules · playbooks: enrich→act · filter ingestion at source"
        }
      ]
    }
  ],
  "answerBank": [
    {
      "q": "How do I start in cybersecurity with no background?",
      "a": "The spine: Linux + networking + the Security+ bridge (Module 1 + Module 3's gate), then pick red or blue. Labs on legal targets from day one — reading without doing doesn't transfer in security.",
      "ref": "il06-hackers-arise"
    },
    {
      "q": "OSCP: is it worth it?",
      "a": "As a methodology credential, yes — it's the most respected hands-on cert in pentesting. Budget 3-6 months of lab time. This module maps PEN-200's methodology; the exam itself is OffSec's 24-hour practical.",
      "ref": "il06-offensive"
    },
    {
      "q": "Blue team or red team?",
      "a": "Learn both basics, then follow the work you can't stop doing: hunters love the chase (blue), breakers love the puzzle (red). The market needs both; the module trains both so you choose informed.",
      "ref": "il06-defensive"
    },
    {
      "q": "Is AI going to replace SOC analysts?",
      "a": "No — it amplifies them. AI drafts summaries and queries; analysts verify, decide, and handle the novel. The module's AI discipline (verify before action) is the skill that keeps you employed.",
      "ref": "il06-fde-interface"
    },
    {
      "q": "SC-200 without Azure experience?",
      "a": "Possible but painful — get AZ-900-level Azure familiarity first, then the module's KQL depth. The exam is 40%+ environment/ATT&CK mapping; portal fluency matters as much as query skill.",
      "ref": "il06-azure-soc"
    },
    {
      "q": "What's the single highest-value defensive skill?",
      "a": "Detection engineering: turning hunts into Sigma rules tuned to your environment. It's the bridge between red knowledge and blue operations — and it's chronically understaffed.",
      "ref": "il06-defensive"
    }
  ],
