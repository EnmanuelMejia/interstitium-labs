   "cards": [
    {
     "front": "SCP vs IAM policy?",
     "back": "IAM grants; SCP bounds (even root). SCPs restrict, never grant."
    },
    {
     "front": "ABAC advantage?",
     "back": "Attribute-based: one policy scales via tags — no role explosion."
    },
    {
     "front": "Org CloudTrail + Object Lock?",
     "back": "Immutable multi-account audit log — attackers can't cover tracks."
    },
    {
     "front": "Envelope encryption?",
     "back": "DEK encrypts data; KEK (KMS) encrypts DEK — performance + centralized key control."
    },
    {
     "front": "S3 Block Public Access level?",
     "back": "Account level first — then bucket policies as defense in depth."
    },
    {
     "front": "Detective's value?",
     "back": "Investigation graphs — pivot from GuardDuty finding to root cause visually."
    },
    {
     "front": "SCPs vs permission boundaries?",
     "back": "Both bound, never grant. SCPs: org-level, even root. Boundaries: cap what a delegated admin can grant."
    },
    {
     "front": "WAF rate-based rule vs Shield?",
     "back": "Rate rules: L7 request floods (brute-force/scraping). Shield: DDoS. Different layers."
    },
    {
     "front": "Detective + GuardDuty workflow?",
     "back": "GuardDuty finds; Detective graphs the pivot to root cause; Athena gives the full timeline."
    },
    {
     "front": "Landing zone in one line?",
     "back": "Control Tower: account factory + preventive (SCP) and detective (Config/Hub) guardrails."
    },
    {
     "front": "Delegate admin creation but cap their power?",
     "back": "**permission boundaries** — Boundaries set the max — delegated admins can't exceed them. — see 'Concepts' in this module's notes."
    },
    {
     "front": "Block all S3 public access org-wide, even for admins?",
     "back": "**SCP deny + account BPA** — SCP (preventive, org-wide, bypasses nothing) + account-level Block Public Access. — see 'Concepts' in this module's notes."
    }
   ],
