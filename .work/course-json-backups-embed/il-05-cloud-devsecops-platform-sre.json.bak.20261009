   "cards": [
    {
     "front": "plan → apply discipline?",
     "back": "Read the plan like a code review. Save it (-out) for the auditable artifact. Never blind-apply in prod."
    },
    {
     "front": "State locking prevents?",
     "back": "Concurrent applies corrupting the state file — DynamoDB/S3-native locks serialize runs."
    },
    {
     "front": "count vs for_each?",
     "back": "for_each: named instances, stable on removal. count: fragile index shifts when one is removed."
    },
    {
     "front": "import then what?",
     "back": "Write matching config immediately — import only binds state; the config must describe it."
    },
    {
     "front": "moved block?",
     "back": "Refactor resources (rename/module-shift) without destroy/recreate."
    },
    {
     "front": "Associate exam's largest area?",
     "back": "The workflow (init/plan/apply) + state — reason from the state model."
    },
    {
     "front": "terraform plan -out=tfplan then apply tfplan — why?",
     "back": "The saved plan is the auditable artifact; apply executes exactly the reviewed diff. Never blind-apply in prod."
    },
    {
     "front": "Hand-edit state?",
     "back": "Never — except via terraform state mv/rm, and back it up first."
    },
    {
     "front": "Workspaces vs separate configs?",
     "back": "Workspaces: same config, separate states — fine small. Serious multi-env: separate configs."
    },
    {
     "front": "Associate (003) largest domain?",
     "back": "The workflow (init/plan/apply) plus state — reason from the state model."
    },
    {
     "front": "apply without plan in production?",
     "back": "**reckless — always review the plan** — The plan is the diff review of infrastructure. Blind apply is how outages are born. — see 'Hands-on procedure' in this module's notes."
    },
    {
     "front": "Two engineers apply simultaneously, no locking. Risk?",
     "back": "**state corruption** — Concurrent writes corrupt state — locking serializes applies. — see 'Concepts' in this module's notes."
    }
   ],
