 "scriptLabs": [
  {
   "id": "il05-lab-terraform-vpc",
   "title": "Terraform: VPC Module from Scratch",
   "brief": "Write a root module + child VPC module: variables, outputs, public/private subnets across 2 AZs, NAT gateway. Required fragments force composition, not a flat file.",
   "starter": "# modules/vpc/main.tf\n# TODO: variables (cidr, azs, name), aws_vpc, public+private subnets (for_each over azs),\n# internet gateway, NAT gateway, route tables + associations, outputs (vpc_id, private_subnet_ids)\n# root main.tf: module \"vpc\" { source = \"./modules/vpc\" ... }",
   "required": [
    "variable",
    "resource",
    "for_each",
    "output",
    "module"
   ],
   "hint": "for_each = toset(var.azs); subnet cidr via cidrsubnet(var.cidr, 8, index). Outputs bubble up to root.",
   "solution": "# modules/vpc/variables.tf\nvariable \"cidr\" { type = string }\nvariable \"azs\" { type = list(string) }\nvariable \"name\" { type = string }\n\n# modules/vpc/main.tf\nresource \"aws_vpc\" \"this\" {\n  cidr_block           = var.cidr\n  enable_dns_hostnames = true\n  tags = { Name = var.name }\n}\nresource \"aws_subnet\" \"public\" {\n  for_each          = toset(var.azs)\n  vpc_id            = aws_vpc.this.id\n  cidr_block        = cidrsubnet(var.cidr, 8, index(var.azs, each.key))\n  availability_zone = each.key\n  map_public_ip_on_launch = true\n  tags = { Name = \"${var.name}-public-${each.key}\" }\n}\nresource \"aws_subnet\" \"private\" {\n  for_each          = toset(var.azs)\n  vpc_id            = aws_vpc.this.id\n  cidr_block        = cidrsubnet(var.cidr, 8, index(var.azs, each.key) + 10)\n  availability_zone = each.key\n  tags = { Name = \"${var.name}-private-${each.key}\" }\n}\nresource \"aws_internet_gateway\" \"this\" { vpc_id = aws_vpc.this.id }\nresource \"aws_eip\" \"nat\" { domain = \"vpc\" }\nresource \"aws_nat_gateway\" \"this\" {\n  allocation_id = aws_eip.nat.id\n  subnet_id     = values(aws_subnet.public)[0].id\n}\n# (route tables + associations follow the same for_each pattern)\noutput \"vpc_id\" { value = aws_vpc.this.id }\noutput \"private_subnet_ids\" { value = [for s in aws_subnet.private : s.id] }\n\n# root main.tf\nmodule \"vpc\" {\n  source = \"./modules/vpc\"\n  cidr   = \"10.0.0.0/16\"\n  azs    = [\"us-east-1a\", \"us-east-1b\"]\n  name   = \"lab\"\n}"
  },
  {
   "id": "il05-lab-k8s-deploy",
   "title": "K8s: Zero-Downtime Deployment Manifests",
   "brief": "Write a Deployment + Service + Ingress for a web app with readiness/liveness probes, resource requests/limits, and a rolling-update strategy. Required fragments force production hygiene.",
   "starter": "# TODO: Deployment (3 replicas, rollingUpdate), container probes (readiness /health, liveness /health),\n# resources.requests/limits, Service ClusterIP, Ingress with host rule.\n# Prove it: kubectl apply, then kubectl rollout status; break the image tag and watch the rollback.",
   "required": [
    "readinessProbe",
    "livenessProbe",
    "resources:",
    "rollingUpdate",
    "kind: Ingress"
   ],
   "hint": "strategy: type: RollingUpdate, maxUnavailable: 0. Probes: httpGet path /health port 8080. Resources: requests cpu 100m/memory 128Mi, limits cpu 500m/memory 512Mi.",
   "solution": "apiVersion: apps/v1\nkind: Deployment\nmetadata: { name: web }\nspec:\n  replicas: 3\n  strategy:\n    type: RollingUpdate\n    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }\n  selector: { matchLabels: { app: web } }\n  template:\n    metadata: { labels: { app: web } }\n    spec:\n      containers:\n      - name: web\n        image: registry.example.com/web:1.4.2\n        ports: [{ containerPort: 8080 }]\n        readinessProbe:\n          httpGet: { path: /health, port: 8080 }\n          periodSeconds: 5\n        livenessProbe:\n          httpGet: { path: /health, port: 8080 }\n          periodSeconds: 15\n        resources:\n          requests: { cpu: 100m, memory: 128Mi }\n          limits: { cpu: 500m, memory: 512Mi }\n---\napiVersion: v1\nkind: Service\nmetadata: { name: web }\nspec:\n  selector: { app: web }\n  ports: [{ port: 80, targetPort: 8080 }]\n---\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata: { name: web }\nspec:\n  rules:\n  - host: web.example.com\n    http:\n      paths:\n      - path: /, pathType: Prefix\n        backend: { service: { name: web, port: { number: 80 } } }\n# prove: kubectl rollout status deploy/web; then set image to :broken, watch it halt; kubectl rollout undo deploy/web"
  },
  {
   "id": "il05-lab-ansible-patch",
   "title": "Ansible: Fleet Patching with Canary",
   "brief": "Write a playbook that patches a web fleet in canary waves: 1 canary host, verify, then the rest — with a handler restarting the app only on kernel change. Idempotent, with --check first.",
   "starter": "---\n- name: patch fleet\n  hosts: web\n  become: true\n  serial: 1  # canary wave\n  tasks:\n    # TODO: dnf upgrade (security), notify handler on change, wait_for port 80 after handler\n  handlers:\n    # TODO: restart app",
   "required": [
    "serial:",
    "notify:",
    "wait_for",
    "become: true"
   ],
   "hint": "serial: 1 for the canary (use --limit canary first), then serial: '25%' for the fleet. dnf: name='*' state=latest security=true. wait_for port 80 delay 10.",
   "solution": "---\n- name: patch canary\n  hosts: web-canary\n  become: true\n  serial: 1\n  tasks:\n    - name: security updates\n      ansible.builtin.dnf:\n        name: '*'\n        state: latest\n        security: true\n      notify: restart app\n    - name: verify serving\n      ansible.builtin.wait_for:\n        port: 80\n        delay: 10\n        timeout: 120\n  handlers:\n    - name: restart app\n      ansible.builtin.service:\n        name: app\n        state: restarted\n# fleet wave after canary is green:\n- name: patch fleet\n  hosts: web-fleet\n  become: true\n  serial: '25%'\n  tasks:\n    - name: security updates\n      ansible.builtin.dnf:\n        name: '*'\n        state: latest\n        security: true\n      notify: restart app\n  handlers:\n    - name: restart app\n      ansible.builtin.service:\n        name: app\n        state: restarted\n# run: ansible-playbook patch.yml --check --diff --limit web-canary  (then for real)"
  }
 ],
