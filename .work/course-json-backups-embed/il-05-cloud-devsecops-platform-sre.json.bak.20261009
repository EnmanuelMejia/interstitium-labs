   "cards": [
    {
     "front": "PIM's job?",
     "back": "Just-in-time elevation: eligible assignments, approval, time-bound — no standing admin."
    },
    {
     "front": "Policy vs RBAC?",
     "back": "RBAC: who can do what (access). Policy: what configurations are allowed (governance)."
    },
    {
     "front": "LRS vs ZRS vs GRS?",
     "back": "LRS: 3 copies, 1 datacenter. ZRS: 3 zones. GRS: + paired region. Durability/cost ladder."
    },
    {
     "front": "NSG evaluation?",
     "back": "Lowest rule number wins; defaults deny inbound internet, allow VNet."
    },
    {
     "front": "Private Endpoint purpose?",
     "back": "PaaS services (Storage, SQL) get VNet-private IPs — off the public internet."
    },
    {
     "front": "AZ-104 heaviest area?",
     "back": "Identity (Entra ID/RBAC/governance) — the control plane, 20-25%."
    },
    {
     "front": "Groups: security vs Microsoft 365?",
     "back": "Security groups: access control. M365 groups: collaboration (Teams/SharePoint) plus optional access."
    },
    {
     "front": "Policy effects?",
     "back": "Deny, audit, deployIfNotExists (and append/modify) — compliance as code at assignment scope."
    },
    {
     "front": "ZRS vs GRS choice?",
     "back": "ZRS: regional resilience, 3 zones. GRS: + paired-region copy for regional disaster. Cost vs blast radius."
    },
    {
     "front": "Cheapest outage insurance?",
     "back": "CanNotDelete locks on production resource groups."
    },
    {
     "front": "Standing Global Admin for 50 admins. Fix?",
     "back": "**PIM eligible + approval + time-bound** — Eliminate standing privilege — PIM makes admin just-in-time and audited. — see 'Concepts' in this module's notes."
    },
    {
     "front": "Enforce 'no public storage' org-wide?",
     "back": "**Azure Policy deny** — Policy governs configuration compliance; RBAC governs access. Different jobs. — see 'Concepts' in this module's notes."
    }
   ],
