   "id": "il05-aws-security",
   "mockTask": {
    "id": "il05-aws-security--mock",
    "type": "choice",
    "q": "Block all S3 public access org-wide, even for admins?",
    "choices": [
     "IAM",
     "SCP deny + account BPA",
     "bucket policy",
