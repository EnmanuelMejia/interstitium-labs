   "handsOnLab": {
    "id": "il05-devops-core--lab",
    "title": "Platform slice: DevOps at Cloud-Native Parity",
    "brief": "You will build a thin but complete slice of DevOps at Cloud-Native Parity as code — provisioned, pipelined, secret-managed, cost-tagged, and torn down — because ClickOps doesn't count.",
    "steps": [
     "Define the slice in IaC: the resources, their configuration, and tags (owner, purpose, expiry).",
