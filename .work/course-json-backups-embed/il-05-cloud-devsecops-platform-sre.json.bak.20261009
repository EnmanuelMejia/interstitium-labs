  {
   "cards": [
    {
     "front": "Canary vs linear vs all-at-once?",
     "back": "Canary: % steps with metric gates. Linear: fixed % per interval. All-at-once: fastest, no safety."
    },
    {
     "front": "Feature flags beat deployments for?",
     "back": "Risk: turn off the feature without redeploying — decouple deploy from release."
    },
    {
     "front": "StackSets solve?",
     "back": "One template across N accounts/regions — org-scale IaC."
    },
    {
     "front": "X-Ray's job?",
     "back": "Distributed tracing — the service map that draws itself; start latency hunts there."
    },
    {
     "front": "Pipeline IAM role discipline?",
     "back": "Least privilege — the pipeline role is a blast radius; scope it to exactly the deploy actions."
    },
    {
     "front": "DOP-C02 pacing?",
     "back": "180 minutes of scenarios — eliminate by constraint, flag 50/50s, keep moving."
    },
    {
     "front": "Canary metric gates watch?",
     "back": "Error rate + latency on the canary vs baseline — automatic rollback on regression."
    },
