 "glossary": [
  {
   "term": "DevOps",
   "definition": "Culture + practices unifying development and operations: CI/CD, automation, shared ownership of production."
  },
  {
   "term": "SRE",
   "definition": "Site Reliability Engineering: applying software engineering to operations — SLOs, error budgets, automation over toil."
  },
  {
   "term": "CI/CD",
   "definition": "Continuous Integration (merge + test often) and Continuous Delivery/Deployment (automated release pipeline)."
  },
  {
   "term": "Kubernetes",
   "definition": "Container orchestrator: schedules pods across nodes, self-heals, exposes services, rolls out updates."
  },
  {
   "term": "Pod",
   "definition": "Smallest Kubernetes unit: one or more containers sharing network and storage, scheduled together."
  },
  {
   "term": "CKA / CKAD / CKS",
   "definition": "CNCF Kubernetes certs: Administrator (cluster ops), Application Developer (workloads), Security Specialist (hardening)."
  },
  {
   "term": "Terraform",
   "definition": "Declarative infrastructure-as-code: HCL config → plan → apply, with state tracking real resources."
  },
  {
   "term": "Drift",
   "definition": "Divergence between IaC-defined state and actual cloud resources (usually from console click-ops)."
  },
  {
   "term": "GitOps",
   "definition": "Git as the source of truth for infrastructure; agents (Argo CD, Flux) converge clusters to the repo state."
  },
  {
   "term": "Service mesh",
   "definition": "Dedicated infrastructure layer (Istio, Linkerd) for service-to-service communication: mTLS, retries, observability."
  },
  {
   "term": "SLO",
   "definition": "Service Level Objective: a target reliability (e.g., 99.9% success) measured by SLIs over a window."
  },
  {
   "term": "Error budget",
   "definition": "Allowed unreliability (1 − SLO): spend it on feature velocity; exhaust it and freeze for reliability work."
  },
  {
   "term": "Observability",
   "definition": "Metrics, logs, and traces — the three pillars for understanding production systems."
  },
  {
   "term": "Vault",
   "definition": "HashiCorp Vault: secrets management — dynamic credentials, encryption-as-a-service, full audit."
  },
  {
   "term": "Consul",
   "definition": "HashiCorp Consul: service networking — discovery, health checking, and service mesh connect."
  },
  {
   "term": "OpenShift",
   "definition": "Red Hat's Kubernetes distribution: opinionated builds, routes, and integrated CI/CD (also: OKD upstream)."
  },
  {
   "term": "Landing zone",
   "definition": "Pre-configured, secure cloud foundation: org structure, IAM baselines, network topology, logging, guardrails."
  },
  {
   "term": "Blue-green / canary",
   "definition": "Deployment strategies: blue-green swaps full environments; canary shifts a fraction of traffic to the new version first."
  },
  {
   "term": "SAST / DAST",
   "definition": "Static (code) and Dynamic (running app) Application Security Testing — the pipeline's security gates."
  },
  {
   "term": "Toil",
   "definition": "Manual, repetitive operational work; SRE caps it (≤50%) and automates the rest."
  }
 ],
 "faq": [
  {
   "q": "CKA, CKAD, or CKS first?",
   "a": "CKA (administer clusters) → CKAD (build on clusters) → CKS (harden clusters). The course sequences modules in exactly that order, since each assumes the previous layer."
  },
  {
   "q": "AWS or Azure — which cloud should I certify in?",
   "a": "Both tracks are in the course because employers split. If forced to choose one first: pick the cloud your target employers run. The concepts (IAM, VPC/VNet, IaC) transfer; only the console paths differ."
  },
  {
   "q": "Terraform vs CloudFormation/Bicep?",
   "a": "Terraform is cloud-agnostic and the industry default for multi-cloud; CloudFormation/Bicep are AWS/Azure-native. Learn Terraform deeply, then each native tool is a weekend."
  },
  {
   "q": "How do I practice Kubernetes without spending money?",
   "a": "kind, k3s, or minikube locally — free. The course's K8s modules are designed for local clusters; cloud only enters for managed-service specifics."
  },
  {
   "q": "What actually is an error budget in practice?",
   "a": "A number with a policy attached: 99.9% SLO = 43 min/month of allowed failure. While budget remains, ship features; when it's gone, all hands fix reliability. It turns 'move fast vs be stable' from argument into arithmetic."
  },
  {
   "q": "Vault vs cloud-native secret managers?",
   "a": "Cloud KMS/Secrets Manager are simpler and fine for single-cloud. Vault earns its complexity with dynamic secrets, multi-cloud uniformity, and detailed audit — which is why the course teaches it."
  },
  {
   "q": "Do I need to pass all these certs?",
   "a": "No — the course maps exam domains to modules so you can *sequence* them over a career. CKA + one cloud associate is the credible entry bundle; the rest are growth rungs."
  },
  {
   "q": "How is this different from IL-28 (DevSecOps bootcamp)?",
   "a": "IL-05 is the platform/SRE *certification* track (K8s stack, AWS/Azure depth, OpenShift). IL-28 is the production *bootcamp* (Linux → containers → IaC → CI/CD → multicloud, calibrated to a hiring panel). IL-05 assumes IL-04-level systems fluency."
  }
 ],
 "tips": [
  "Follow the guided path in order — each module unlocks the next. The sequence is the curriculum; skipping ahead breaks the chain.",
  "This course maps to AWS Certified Solutions Architect – Associate (SAA-C03) and AWS Certified DevOps Engineer – Professional (DOP-C02) (independent preparation — no affiliation). Weight your drill time toward the heaviest exam domains shown in the cert gates.",
  "The math modules (Probability & Statistics, Graphs & Discrete Structures) are load-bearing — finish them before the applied modules that assume them.",
  "Quiz-gated modules need 70%+ to unlock the next. When you miss a question, ask Noah to walk you through the miss Socratically before re-attempting.",
  "Do each hands-on lab twice — once following the guide, once from a blank screen. The second pass is where the skill sticks.",
  "This is a 92-hour course: at 10 focused hours a week it takes about 2 months. Short daily sessions beat weekend cramming — pace it like a semester."
 ],
 "legends": {
  "✓ Complete": "Module finished — marked complete by you, or auto-marked when you scrolled the whole module.",
  "✓ Mastered": "Module finished AND its quiz mastery gate passed (score of 70% or higher).",
  "✓ Tested out": "Placed out via the diagnostic — counts as passed without completing the module.",
  "● You are here": "Your current position in the guided sequence.",
  "→ Up next": "The next module in the sequence — unlocks when the current lesson is passed.",
  "🔒 Locked": "Complete the previous lesson to unlock this module.",
  "⚠ Mastery gate": "This module has a quiz gate — score 70% or higher to pass and unlock the next module.",
  "Readiness ring": "Brief tab — your overall preparedness across this course's objectives, computed from completions and quiz scores.",
  "Noah": "Noah AI — your Socratic tutor. Ask with a hypothesis; it guides with questions before answers, grounded in this course.",
  "Continue where you left off": "Resume banner — jumps to the exact module you last opened, on this device.",
  "Next →": "End-of-module button — advances to the next module in the guided sequence (disabled until the current lesson is passed).",
  "Mark module complete": "Module footer button — records the module as done in your progress.",
  "FREE / lock badge": "Academy catalog — FREE means open to everyone; the lock means the course needs purchase (checkout)."
 }
}