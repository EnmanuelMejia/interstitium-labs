  {
   "id": "drill-il05-res1",
   "title": "CrashLoop triage",
   "prompt": "A pod is CrashLoopBackOff. Fastest first command?",
   "choices": [
    "kubectl delete pod and hope",
    "kubectl logs <pod> --previous",
    "kubectl drain the node",
    "Restart kubelet on all nodes"
   ],
   "answer": 1,
   "explain": "The previous container's logs usually name the cause (bad entrypoint, missing env, failed probe). Describe shows events; logs --previous shows the crash output."
  },
  {
   "id": "drill-il05-res2",
   "title": "Terraform state",
   "prompt": "Two engineers run `terraform apply` simultaneously against a local state file. The risk is:",
   "choices": [
    "Nothing — Terraform merges automatically",
    "State corruption / conflicting applies — use a remote backend with locking",
    "Double billing only",
    "Plan always fails safely"
   ],
   "answer": 1,
   "explain": "Local state has no locking; concurrent applies corrupt it. Remote backends (S3+DynamoDB, AzureRM, GCS) provide locking."
  },
  {
   "id": "drill-il05-res3",
   "title": "SLO math",
   "prompt": "A 99.95% monthly SLO allows roughly how much downtime?",
   "choices": [
    "~43 minutes",
    "~22 minutes",
    "~4.4 minutes",
    "~7 hours"
   ],
   "answer": 1,
   "explain": "0.05% of ~43,800 min/month ≈ 22 min. (99.9% ≈ 43m; 99.99% ≈ 4.4m.)"
  },
  {
   "id": "drill-il05-res4",
   "title": "Security groups vs NACLs",
   "prompt": "In AWS, which is stateful?",
   "choices": [
    "Network ACLs",
    "Security groups",
    "Route tables",
    "Internet gateways"
   ],
   "answer": 1,
   "explain": "Security groups are stateful (return traffic auto-allowed); NACLs are stateless (explicit inbound+outbound rules)."
  },
  {
   "id": "drill-il05-res5",
   "title": "Vault purpose",
   "prompt": "HashiCorp Vault's primary job in this course's platform is:",
   "choices": [
    "Container orchestration",
    "Secrets management with dynamic credentials and audit",
    "Log aggregation",
    "DNS resolution"
   ],
   "answer": 1,
   "explain": "Vault issues short-lived dynamic secrets, encrypts data, and audits every access — replacing static credentials in config files."
  }
 ],
 "scenarios": [
  {
   "id": "il05-scn-outage",
   "title": "Region Degradation at 2 AM",
   "context": "us-east-1 degraded: your ALB targets are unhealthy in 1 of 3 AZs. PagerDuty fires.",
   "steps": [
    {
     "prompt": "First action?",
     "options": [
      {
       "text": "Check target health + AZ status; drain the bad AZ if the app is multi-AZ healthy",
       "correct": true,
       "why": "Scope first: one AZ degraded with healthy others = drain and ride it out, then investigate."
      },
      {
       "text": "Fail over to another region immediately",
       "correct": false,
       "why": "Regional failover for an AZ issue is over-escalation — it risks the failover itself."
      },
      {
       "text": "Restart all instances",
       "correct": false,
       "why": "Restarts destroy evidence and don't fix AZ-level degradation."
      }
     ]
    },
    {
     "prompt": "The AZ recovers but targets flap. Next?",
     "options": [
      {
       "text": "Review health-check config + recent deploys; check the canary metrics",
       "correct": true,
       "why": "Flapping after recovery smells like a bad deploy or misconfigured health check — evidence first."
      },
      {
       "text": "Add more instances",
       "correct": false,
       "why": "More instances of a flapping app = more flapping. Fix the cause."
      }
     ]
    }
   ]
  },
  {
   "id": "il05-scn-drift",
   "title": "Terraform Says 47 Changes",
   "context": "Monday plan shows 47 changes nobody made. Production stack.",
   "steps": [
    {
     "prompt": "First move?",
     "options": [
      {
       "text": "Review the plan resource by resource — identify console drift vs real need",
       "correct": true,
       "why": "The plan is the diff review: classify each change (drift to revert, drift to adopt, real change) before touching apply."
      },
      {
       "text": "Apply immediately to converge",
       "correct": false,
       "why": "Blind apply could revert a deliberate hotfix or destroy something the drift created intentionally."
      },
      {
       "text": "Delete the state file",
       "correct": false,
       "why": "Deleting state orphans real resources — the nuclear option for a reading problem."
      }
     ]
    },
    {
     "prompt": "40 changes are console drift (someone scaled manually), 7 are your intended updates. Move?",
     "options": [
      {
       "text": "Import/adopt the intentional drift into config, revert the rest via targeted apply, document the rule",
       "correct": true,
       "why": "Adopt what's deliberate (write it into config), revert the rest, and set the team rule: infra changes go through Terraform."
      },
      {
       "text": "Apply all 47",
       "correct": false,
       "why": "Applies the 7 you want and reverts 40 someone may depend on — without telling anyone."
      }
     ]
    }
   ]
  }
 ],
 "trainers": [
  {
   "id": "il05-trainer-kubectl",
   "title": "kubectl Speed Trainer",
   "brief": "CKA/CKAD imperative-command sprints: random tasks ('expose deploy X', 'scale to 5', 'get logs of failing pod'), type the kubectl. Streak-tracked — the performance exams reward speed.",
   "kind": "custom"
  }
 ],
 "terminalSims": [
  {
   "id": "il05-term-kubectl",
   "title": "kubectl Triage Simulator",
   "brief": "A broken cluster in canned form: CrashLoopBackOff pod, pending pod, failing probe. Diagnose with describe/logs/get — exact match with fuzzy hints.",
   "prompt": "operator@k8s:~$ ",
   "commands": [
    {
     "cmd": "kubectl get pods",
     "out": "NAME                   READY   STATUS             RESTARTS\nweb-7d9f8c6b9d-abc12   0/1     CrashLoopBackOff   7\napi-5c4d3e2f1a-def34   0/1     Pending            0"
    },
    {
     "cmd": "kubectl logs web-7d9f8c6b9d-abc12",
     "out": "Error: cannot find config file at /etc/app/config.yaml\nprocess exited with code 1"
    },
    {
     "cmd": "kubectl describe pod api-5c4d3e2f1a-def34",
     "out": "Events:\n  Warning  FailedScheduling  0/3 nodes available: 3 Insufficient cpu."
    },
    {
     "cmd": "kubectl get events --sort-by=.lastTimestamp | tail -3",
     "out": "Warning FailedScheduling pod/api-5c4d3e2f1a-def34 0/3 nodes are available: 3 Insufficient cpu.\nWarning BackOff pod/web-7d9f8c6b9d-abc12 Back-off restarting failed container"
    },
    {
     "cmd": "help",
     "out": "Available: kubectl get pods, kubectl logs <pod>, kubectl describe pod <pod>, kubectl get events --sort-by=.lastTimestamp | tail -3"
    }
   ]
  },
  {
   "id": "il05-term-terraform",
   "title": "Terraform Workflow Simulator",
   "brief": "The plan/apply cycle canned: init, validate, plan with drift, targeted apply. Learn to read plans before touching production.",
   "prompt": "tf@workstation:~/vpc$ ",
   "commands": [
    {
     "cmd": "terraform init",
     "out": "Initializing modules and provider plugins... Terraform has been successfully initialized!"
    },
    {
     "cmd": "terraform validate",
     "out": "Success! The configuration is valid."
    },
    {
     "cmd": "terraform plan -out=tfplan",
     "out": "Plan: 12 to add, 0 to change, 3 to destroy.\nWarning: 2 resources show drift (manual console changes)."
    },
    {
     "cmd": "terraform apply tfplan",
     "out": "Apply complete! Resources: 12 added, 0 changed, 3 destroyed."
    },
    {
     "cmd": "help",
     "out": "Available: terraform init, terraform validate, terraform plan -out=tfplan, terraform apply tfplan"
    }
   ]
  }
 ],
 "mockMinutes": 120,
 "mockTasks": [
  {
   "id": "il05-m01",
   "type": "choice",
   "q": "Multi-stage build benefit?",
   "choices": [
    "faster builds",
    "slim runtime image",
    "more layers",
    "easier debug"
   ],
   "answer": 1,
   "explain": "Compile fat, ship slim — 800MB → 15MB."
  },
  {
   "id": "il05-m02",
   "type": "choice",
   "q": "etcd lost, no backup?",
   "choices": [
    "self-heals",
    "cluster state lost",
    "fine",
    "logs lost"
   ],
   "answer": 1,
   "explain": "etcd IS the state. Back it up."
  },
  {
   "id": "il05-m03",
   "type": "choice",
   "q": "Pod OOMKilled: first check?",
   "choices": [
    "node RAM",
    "memory limits vs usage",
    "image",
    "network"
   ],
   "answer": 1,
   "explain": "Cgroup limit hit — compare limits to real usage."
  },
  {
   "id": "il05-m04",
   "type": "choice",
   "q": "Readiness probe fails: effect?",
   "choices": [
    "restart",
    "removed from endpoints, no restart",
    "node drain",
    "paused"
   ],
   "answer": 1,
   "explain": "Readiness gates traffic; liveness restarts."
  },
  {
   "id": "il05-m05",
   "type": "choice",
   "q": "Per-session least privilege = which tenet?",
   "choices": [
    "1",
    "3",
    "5",
    "7"
   ],
   "answer": 1,
   "explain": "Tenet 3: access granted per session."
  },
  {
   "id": "il05-m06",
   "type": "choice",
   "q": "Phishing-resistant MFA?",
   "choices": [
    "SMS",
    "TOTP",
    "FIDO2",
    "email"
   ],
   "answer": 2,
   "explain": "FIDO2: origin-bound crypto, not relayable."
  },
  {
   "id": "il05-m07",
   "type": "choice",
   "q": "count vs for_each removal?",
   "choices": [
    "same",
    "for_each stable; count shifts indices",
    "count stable",
    "both break"
   ],
   "answer": 1,
   "explain": "for_each keys by name — removal doesn't cascade."
  },
  {
   "id": "il05-m08",
   "type": "choice",
   "q": "Brownfield server into Terraform?",
   "choices": [
    "delete",
    "import then write config",
    "ignore",
    "recreate"
   ],
   "answer": 1,
   "explain": "Import binds state; config must describe it."
  },
  {
   "id": "il05-m09",
   "type": "choice",
   "q": "Instances in 1 AZ behind multi-AZ ALB: resilient?",
   "choices": [
    "yes",
    "no",
    "overkill",
    "maybe"
   ],
   "answer": 1,
   "explain": "ALB survives; instances don't — resilience needs multi-AZ everywhere."
  },
  {
   "id": "il05-m10",
   "type": "choice",
   "q": "Sync inventory calls cascade on slowness. Fix?",
   "choices": [
    "bigger boxes",
    "SQS decouple",
    "faster net",
    "threads"
   ],
   "answer": 1,
   "explain": "Queue it: failures become depth, retries replace errors."
  },
  {
   "id": "il05-m11",
   "type": "choice",
   "q": "NACL allows 443 in, app unreachable. Check?",
   "choices": [
    "SG",
    "NACL outbound ephemeral range",
    "DNS",
    "IAM"
   ],
   "answer": 1,
   "explain": "Stateless — return traffic needs an explicit outbound rule."
  },
  {
   "id": "il05-m12",
   "type": "choice",
   "q": "Delegate admin creation, cap power?",
   "choices": [
    "full admin",
    "permission boundaries",
    "trust",
    "none"
   ],
   "answer": 1,
   "explain": "Boundaries cap delegated admins."
  },
  {
   "id": "il05-m13",
   "type": "choice",
   "q": "Standing admin for 50 people?",
   "choices": [
    "fine",
    "PIM just-in-time",
    "shared",
    "more"
   ],
   "answer": 1,
   "explain": "Eliminate standing privilege with PIM."
  },
  {
   "id": "il05-m14",
   "type": "choice",
   "q": "Blob untouched 180 days?",
   "choices": [
    "Hot",
    "lifecycle to Cool/Archive",
    "Premium",
    "delete"
   ],
   "answer": 1,
   "explain": "Lifecycle policy follows the access pattern."
  },
  {
   "id": "il05-m15",
   "type": "choice",
   "q": "Global app, instant failover, WAF?",
   "choices": [
    "TM",
    "Front Door",
    "LB",
    "VPN"
   ],
   "answer": 1,
   "explain": "Front Door: global edge + instant failover + WAF."
  },
  {
   "id": "il05-m16",
   "type": "choice",
   "q": "App DB creds, must rotate?",
   "choices": [
    "env",
    "Vault dynamic secrets",
    "hardcode",
    "file"
   ],
   "answer": 1,
   "explain": "Dynamic: leased, auto-revoked."
  },
  {
   "id": "il05-m17",
   "type": "choice",
   "q": "Same image dev→prod, DB URL differs. Factor?",
   "choices": [
    "rebuild",
    "env-var config",
    "hardcode",
    "per-env image"
   ],
   "answer": 1,
   "explain": "Twelve-factor: config in environment."
  },
  {
   "id": "il05-m18",
   "type": "choice",
   "q": "rate() over?",
   "choices": [
    "gauges",
    "counters",
    "strings",
    "bools"
   ],
   "answer": 1,
   "explain": "rate() needs a counter — the PromQL trap."
  }
 ],
 "cheatSheets": [
  {
   "title": "IL-05 DevOps & K8s Quick Reference",
   "blocks": [
    {
     "h": "Docker",
     "body": "Multi-stage: build fat → ship slim · COPY . . LAST · layers cache: slow-changing first"
    },
    {
     "h": "K8s triage",
     "body": "kubectl describe → logs → events → kubelet · requests schedule, limits kill · readiness gates traffic, liveness restarts"
    },
    {
     "h": "CKA speed",
     "body": "kubectl create/run/expose --dry-run=client -o yaml > f.yaml · aliases: k=kubectl · --force for recreates"
    },
    {
     "h": "Terraform",
     "body": "init→validate→plan→apply · read the plan · state locked remotely · for_each over count · import then config"
    }
   ]
  },
  {
   "title": "IL-05 Cloud Architecture Quick Reference",
   "blocks": [
    {
     "h": "AWS",
     "body": "Multi-AZ everywhere · decouple with SQS · SG stateful / NACL stateless · Aurora=relational, DynamoDB=key-value · Savings Plans for baseline"
    },
    {
     "h": "Azure",
     "body": "PIM kills standing admin · Policy governs config, RBAC governs access · Zones > sets · Private Endpoints for PaaS · hub-spoke, non-transitive peering"
    },
    {
     "h": "Security",
     "body": "SCPs bound, IAM grants · ABAC via tags · org Trail + Object Lock · KMS envelope encryption · WAF rate rules for floods"
    },
    {
     "h": "GitOps",
     "body": "Git is truth, cluster is cache · Argo CD syncs · drift detected not debated · Rollouts for progressive delivery"
    }
   ]
  },
  {
   "title": "Kubernetes — the CKA/CKAD survival card",
   "blocks": [
    {
     "h": "Objects",
     "body": "Pod (smallest unit) → ReplicaSet (count) → Deployment (rollout) → Service (stable endpoint) → Ingress (L7 routing). ConfigMap/Secret = config; PVC = storage."
    },
    {
     "h": "kubectl triage",
     "code": "kubectl get pods -A | grep -v Running\nkubectl describe pod <p>     # events tell the story\nkubectl logs <p> --previous  # crashed container\nkubectl exec -it <p> -- sh",
     "lang": "bash"
    },
    {
     "h": "CrashLoopBackOff",
     "body": "Container starts then dies repeatedly. Check: logs --previous, wrong image/entrypoint, missing env/secret, failed liveness probe, OOMKilled (limits too low)."
    },
    {
     "h": "Networking",
     "body": "Every pod gets an IP; kube-proxy programs Service VIPs. DNS: <svc>.<ns>.svc.cluster.local. NetworkPolicy = firewall between pods (default allow-all!)."
    },
    {
     "h": "CKA exam tips",
     "body": "Know `kubectl` imperatively (`run`, `create`, `expose`) — it's faster than YAML under time. Alias k=kubectl, enable completion. Read events before logs."
    }
   ]
  },
  {
   "title": "Terraform — state, plan, apply without fear",
   "blocks": [
    {
     "h": "The loop",
     "code": "terraform init     # providers + backend\nterraform plan    # diff: what will change\nterraform apply   # execute (approve!)\nterraform destroy # tear down",
     "lang": "bash"
    },
    {
     "h": "State is truth",
     "body": "State file maps config → real resources. Remote backend (S3+DynamoDB / AzureRM / GCS) + locking = team-safe. Never hand-edit state; use `import` and `mv`."
    },
    {
     "h": "Drift",
     "body": "`plan` on a schedule (or `terraform plan -detailed-exitcode` in CI) detects click-ops drift. Import drifted resources or revert them — pick one, document it."
    },
    {
     "h": "Modules & workspaces",
     "body": "Modules = reusable packages (registry or git). Workspaces or separate dirs per env (dev/stage/prod) — never one state for all envs."
    },
    {
     "h": "Secrets",
     "body": "Never commit .tfvars with secrets or state files. Use Vault/AWS Secrets Manager/Azure Key Vault via data sources; mark outputs sensitive."
    }
   ]
  },
  {
   "title": "AWS + Azure — the dual-cloud map",
   "blocks": [
    {
     "h": "Identity",
     "body": "AWS IAM: users → groups → roles; policies are JSON allow/deny; always MFA on root, use roles not keys. Azure: Entra ID → RBAC roles on scopes (MG/sub/RG/resource)."
    },
    {
     "h": "Network",
     "body": "AWS VPC: subnets, route tables, IGW/NAT, security groups (stateful) + NACLs (stateless). Azure VNet: subnets, NSGs, UDRs, Private Link/Private DNS."
    },
    {
     "h": "Compute ladder",
     "body": "VMs (EC2/Azure VM) → containers (ECS/AKS) → serverless (Lambda/Functions). Right-size before you reserve; autoscale on real metrics."
    },
    {
     "h": "Exam anchors",
     "body": "SAA-C03: design resilient/architected workloads. SysOps: operate + monitor. DOP-C02: CI/CD at scale. AZ-104: administer Azure. AZ-305: design. AZ-700: network deep-dive."
    }
   ]
  },
  {
   "title": "DevOps toolchain — Git to Grafana in one flow",
   "blocks": [
    {
     "h": "The pipeline",
     "body": "Commit → CI (build, unit test, SAST) → artifact registry → CD to staging (integration/DAST) → prod (canary/blue-green) → observe (metrics, logs, traces)."
    },
    {
     "h": "Quality gates",
     "body": "Block promotion on: failing tests, critical CVEs, coverage floor, secret scan hits. Gates are policy as code, not meetings."
    },
    {
     "h": "Observability",
     "body": "Metrics (Prometheus: RED/USE) → dashboards (Grafana) → alerts (Alertmanager). Logs centralized (ELK/Loki). Traces for latency (Tempo/Jaeger)."
    },
    {
     "h": "SRE math",
     "body": "SLO 99.9% = 43m error budget/month. Burn the budget → freeze features, fix reliability. Blameless postmortems, action items with owners."
    }
   ]
  }
 ],
 "answerBank": [
  {
   "q": "AWS or Azure — which spine?",
   "a": "By job market target: AWS for startups/scale-ups breadth, Azure for enterprise/Microsoft shops. The concepts transfer ~80% (IAM/RBAC, VPC/VNet, S3/Blob). Pick one, go deep, then map the second in weeks not months.",
   "ref": "il05-aws-architect"
  },
  {
   "q": "CKA vs CKAD — which first?",
   "a": "CKA if you'll operate clusters; CKAD if you'll ship apps to them. Most learners benefit from CKA first — the admin mental model makes the developer exam easier. Both are performance-based: practice in live clusters.",
   "ref": "il05-cloud-native"
  },
  {
   "q": "Terraform or CloudFormation/ARM?",
   "a": "Terraform for multi-cloud and marketability; CloudFormation/ARM for deep single-cloud shops. Learn Terraform first (the concepts transfer), then read the native tool. This module's Associate prep is Terraform.",
   "ref": "il05-terraform"
  },
  {
   "q": "How do I practice CKS without a budget?",
   "a": "Local clusters (kind/k3d) + Falco + a vulnerability scanner. The CKS skills (hardening, supply chain, runtime) all run locally. The exam environment is remote but the skills are identical.",
   "ref": "il05-cloud-native"
  },
  {
   "q": "Zero trust — where do I actually start?",
   "a": "Identity: phishing-resistant MFA everywhere + PIM for admins. That's 60% of the value. Then device posture, then microsegmentation. The module sequences SP 800-207 into this order.",
   "ref": "il05-zero-trust"
  },
  {
   "q": "Vault vs cloud KMS/secrets manager?",
   "a": "Vault for multi-cloud/dynamic secrets/PKI-as-a-service; cloud-native secrets managers for single-cloud simplicity. Learn Vault's model (engines/auth/policies) — it teaches secrets thinking that transfers.",
   "ref": "il05-hashicorp-vault"
  }
 ],
