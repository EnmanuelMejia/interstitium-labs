   "cards": [
    {
     "front": "etcd's role?",
     "back": "The cluster's source of truth — all state lives here. Back it up: etcdctl snapshot save."
    },
    {
     "front": "Requests vs limits?",
     "back": "Requests: scheduling guarantee. Limits: throttle (CPU) or kill (memory). Set honestly/defensively."
    },
    {
     "front": "Liveness vs readiness?",
     "back": "Liveness: restart the container. Readiness: remove from service endpoints. Startup: for slow starters."
    },
    {
     "front": "CKA/CKAD/CKS exam format?",
     "back": "2-hour performance-based, docs allowed. Speed with kubectl is the skill."
    },
    {
     "front": "Pod Security Standards order?",
     "back": "Privileged → baseline → restricted (most locked down)."
    },
    {
     "front": "Falco watches what?",
     "back": "Runtime syscalls — detects anomalous behavior in running containers."
    },
    {
     "front": "kubelet's job?",
     "back": "The node agent: watches the API server for pod specs, runs the containers via the CRI, and reports status back. No kubelet, no workloads."
    },
    {
     "front": "Fix order for a broken workload?",
     "back": "kubectl describe → kubectl logs → events → kubelet. Same order every time."
    },
    {
     "front": "ImagePolicyWebhook / admission control role?",
     "back": "The policy enforcement point — where supply-chain rules (scan, sign) actually bite."
    },
    {
     "front": "KCSA → CKS ladder?",
     "back": "KCSA builds associate-depth security vocabulary; CKS tests it hands-on. Requires CKA."
    },
    {
     "front": "etcd data lost, no backup. Outcome?",
     "back": "**cluster state lost — rebuild** — etcd IS the cluster state. No backup = rebuild. Back it up. — see 'Concepts' in this module's notes."
    },
    {
     "front": "Pod OOMKilled repeatedly. First check?",
     "back": "**memory limits vs actual usage** — OOMKill = cgroup limit hit. Check limits against real usage (metrics-server). — see 'Concepts' in this module's notes."
    }
