   "cards": [
    {
     "front": "CloudTrail vs Config?",
     "back": "Trail: who did what (API activity). Config: what changed (resource state + rules). Paired constantly."
    },
    {
     "front": "Blue/green's real feature?",
     "back": "Instant rollback — deploy safety is the point, not just zero downtime."
    },
    {
     "front": "VPC Gateway vs Interface endpoints?",
     "back": "Gateway: S3/DynamoDB, free, route-table. Interface: PrivateLink services, hourly charge."
    },
    {
     "front": "Untested backup = ?",
     "back": "A rumor. Test restores on schedule — the RTO is only real if proven."
    },
    {
     "front": "GuardDuty → response loop?",
     "back": "Findings → EventBridge → Lambda/SSM automation — detect to remediate without humans."
    },
    {
