   "id": "il05-aws-architect",
   "mockTask": {
    "id": "il05-aws-architect--mock",
    "type": "choice",
    "q": "Order service calls inventory synchronously; inventory slowdowns cascade. Fix?",
    "choices": [
     "bigger instances",
     "more threads",
