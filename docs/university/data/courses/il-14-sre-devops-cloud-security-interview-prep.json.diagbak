 "scriptLabs": [
  {
   "id": "il-14-lab-error-budget",
   "title": "Error-budget calculator",
   "brief": "Turn SLO math into code: given total requests, failed requests, and an SLO, compute the percentage of the error budget consumed. The arithmetic behind every burn-rate conversation.",
   "starter": "def budget_consumed(total_requests, failed_requests, slo):\n    \"\"\"Return the % of the error budget consumed (0-100+, may exceed 100).\n\n    slo: e.g. 0.999 for a 99.9% SLO.\n    \"\"\"\n    # TODO: allowed failures = total * (1 - slo); consumed % = failed / allowed * 100.\n    pass\n",
   "required": [
    "1 - slo",
    "allowed",
    "* 100"
   ],
   "hint": "Budget = total × (1 − SLO); consumed % = failed ÷ allowed × 100. Guard the zero-allowed edge case.",
   "solution": "def budget_consumed(total_requests, failed_requests, slo):\n    allowed = total_requests * (1 - slo)\n    if allowed <= 0:\n        return 100.0 if failed_requests > 0 else 0.0\n    return (failed_requests / allowed) * 100\n\n# Example: 1M requests, 500 failed, 99.9% SLO -> 50% of budget consumed.\nprint(budget_consumed(1_000_000, 500, 0.999))\n"
  },
  {
   "id": "il-14-lab-k8s-deploy",
   "title": "Production-ready Deployment manifest",
   "brief": "Write a Kubernetes Deployment you’d defend in an interview: replicas, probes, resource requests/limits, and labels. The manifest is the artifact; the narration is the score.",
   "starter": "# TODO: complete this Deployment for a web API named 'api' (image api:1.4.2).\n# Requirements: 3 replicas, readiness + liveness probes on /healthz,\n# CPU/memory requests AND limits, app=api labels.\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api\n",
   "required": [
    "replicas: 3",
    "readinessProbe",
    "livenessProbe",
    "resources:",
    "image: api:1.4.2"
   ],
   "hint": "Probes need httpGet on /healthz with initialDelaySeconds; resources need both requests and limits; matchLabels must equal the pod template labels.",
   "solution": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api\n  labels:\n    app: api\nspec:\n  replicas: 3\n  selector:\n    matchLabels:\n      app: api\n  template:\n    metadata:\n      labels:\n        app: api\n    spec:\n      containers:\n      - name: api\n        image: api:1.4.2\n        ports:\n        - containerPort: 8080\n        readinessProbe:\n          httpGet:\n            path: /healthz\n            port: 8080\n          initialDelaySeconds: 5\n          periodSeconds: 10\n        livenessProbe:\n          httpGet:\n            path: /healthz\n            port: 8080\n          initialDelaySeconds: 15\n          periodSeconds: 20\n        resources:\n          requests:\n            cpu: \"250m\"\n            memory: \"256Mi\"\n          limits:\n            cpu: \"1000m\"\n            memory: \"512Mi\"\n"
  },
  {
   "id": "il-14-lab-burn-rate-alert",
   "title": "Burn-rate alert rule (Prometheus)",
   "brief": "Write the fast-burn Prometheus alert you’d actually ship: budget-consumption ratio over two windows, a for-duration, and a severity. Symptom-based alerting, as the module teaches.",
   "starter": "# TODO: alert when the service burns its 99.9% SLO error budget too fast.\n# Metrics: http_requests_total, http_requests_failed_total (counter, label-free).\n# Requirements: burn-rate expression, 'for' duration, severity label, summary annotation.\ngroups:\n- name: slo-burn\n  rules:\n",
   "required": [
    "for:",
    "severity:",
    "expr:",
    "http_requests_failed_total"
   ],
   "hint": "Burn rate = failed-rate / (total-rate × budget-ratio). For 99.9%, the budget ratio is 0.001; alert when the ratio exceeds ~14x over both a 1h and a 5m window.",
   "solution": "groups:\n- name: slo-burn\n  rules:\n  - alert: HighErrorBudgetBurn\n    expr: |\n      (\n        sum(rate(http_requests_failed_total[1h]))\n        /\n        sum(rate(http_requests_total[1h]))\n      ) > 0.001 * 14.4\n      and\n      (\n        sum(rate(http_requests_failed_total[5m]))\n        /\n        sum(rate(http_requests_total[5m]))\n      ) > 0.001 * 14.4\n    for: 15m\n    labels:\n      severity: critical\n    annotations:\n      summary: \"Error budget burning 14x faster than the 99.9% SLO allows\"\n"
  },
  {
   "id": "il-14-lab-triage",
   "title": "Triage runbook: pods CrashLooping",
   "brief": "Write the ordered triage script you’d narrate in a live troubleshooting round: from symptom to cause in kubectl commands. Hypothesis → test → observe, said out loud.",
   "starter": "#!/usr/bin/env bash\n# Triage: pods for deployment 'api' are CrashLooping.\n# TODO: ordered commands — status, events, logs, resources, recent changes.\nset -euo pipefail\nNS=prod\n",
   "required": [
    "kubectl get pods",
    "kubectl describe",
    "kubectl logs",
    "kubectl top"
   ],
   "hint": "Order: what’s happening (get/describe) → why it dies (logs of the previous container) → resource pressure (top) → what changed (rollout history).",
   "solution": "#!/usr/bin/env bash\n# Triage: 'api' pods CrashLooping in prod.\nset -euo pipefail\nNS=prod\n\necho \"== 1. What is happening?\"\nkubectl get pods -n \"$NS\" -l app=api\nkubectl describe deployment api -n \"$NS\" | tail -20\n\necho \"== 2. Why did the container die? (previous container logs)\"\nkubectl logs -n \"$NS\" -l app=api --previous --tail=100 || true\n\necho \"== 3. Resource pressure?\"\nkubectl top pods -n \"$NS\" -l app=api || true\n\necho \"== 4. What changed recently?\"\nkubectl rollout history deployment/api -n \"$NS\"\n\necho \"== 5. Events tell the story\"\nkubectl get events -n \"$NS\" --sort-by=.lastTimestamp | tail -20\n"
  }
 ],
 "drills": [
  {
   "id": "il-14-drill-01",
   "title": "SLIs, SLOs, and Error Budgets",
   "prompt": "When the error budget is exhausted, the correct policy is:",
   "choices": [
    "Ship faster",
    "Freeze or slow risky releases until the budget recovers",
    "Lower the SLO",
    "Ignore it"
   ],
   "answer": 1,
   "explain": "The budget is the agreed tradeoff dial: spending it all means reliability work comes first."
  },
  {
   "id": "il-14-drill-02",
   "title": "CI/CD Systems",
   "prompt": "Canary deployment’s defining feature is:",
   "choices": [
    "Two full environments",
    "Releasing to a small subset first and promoting based on observed metrics",
    "Instant cutover",
    "No automation"
   ],
   "answer": 1,
   "explain": "Progressive exposure with metric gates: problems hit 1% before 100%."
  },
  {
   "id": "il-14-drill-03",
   "title": "Core Cloud Concepts",
   "prompt": "Leading with vendor-neutral concepts in an interview is strong because:",
   "choices": [
    "Vendors don’t matter",
    "It proves transferable understanding, not memorized console paths",
    "It’s faster",
    "Interviewers dislike AWS"
   ],
   "answer": 1,
   "explain": "Concepts survive provider changes; click-path knowledge expires with the UI."
  },
  {
   "id": "il-14-drill-04",
   "title": "Application Security Fundamentals",
   "prompt": "SSRF’s cloud nightmare scenario is:",
   "choices": [
    "Slow responses",
    "Hitting the instance metadata service to steal temporary credentials",
    "DNS failure",
    "High bills"
   ],
   "answer": 1,
   "explain": "The metadata endpoint is one hop from the vulnerable server — credentials included."
  },
  {
   "id": "il-14-drill-05",
   "title": "DSA Speed Reps",
   "prompt": "Redrilling the miss category (not just the problem) works because:",
   "choices": [
    "It’s faster",
    "Interviews test categories under new disguises — the instance never repeats",
    "Problems repeat",
    "It’s trendy"
   ],
   "answer": 1,
   "explain": "The next problem will wear a different costume; the category is what transfers."
  },
  {
   "id": "drill-il14-res1",
   "title": "Budget math",
   "prompt": "99.99% SLO over 30 days. Error budget?",
   "choices": [
    "~43 minutes",
    "~4.4 minutes",
    "~7 hours",
    "~22 minutes"
   ],
   "answer": 1,
   "explain": "0.01% of 43,200 min ≈ 4.3 min. Four nines is brutal — that's the point of the arithmetic."
  },
  {
   "id": "drill-il14-res2",
   "title": "First mitigation",
   "prompt": "A deploy 10 minutes ago correlates with error spike. Fastest mitigation?",
   "choices": [
    "Debug the new code in production",
    "Roll back to the previous version, then investigate",
    "Scale up 10×",
    "Wait for auto-recovery"
   ],
   "answer": 1,
   "explain": "Rollback restores service in minutes; root-causing can happen safely afterward. Mitigate first, diagnose second."
  },
  {
   "id": "drill-il14-res3",
   "title": "Alert design",
   "prompt": "Best alert for a user-facing SLO?",
   "choices": [
    "CPU > 80%",
    "Burn-rate-based multi-window alert on the SLI",
    "Disk > 90%",
    "Any single error log line"
   ],
   "answer": 1,
   "explain": "Alert on the user-impacting SLI's burn rate, not on infrastructure symptoms. Multi-window avoids flapping."
  },
  {
   "id": "drill-il14-res4",
   "title": "IaC interview",
   "prompt": "Asked 'how do you handle Terraform state in a team?', the key points are:",
   "choices": [
    "Local state files in git",
    "Remote backend with locking, separate state per environment, no secrets in state committed anywhere",
    "One state file for everything",
    "Email the state file around"
   ],
   "answer": 1,
   "explain": "Remote + locked + per-env state; secrets via Vault/cloud managers, never in committed state."
  },
  {
   "id": "drill-il14-res5",
   "title": "Security interview",
   "prompt": "'How would you secure a CI/CD pipeline?' Lead with:",
   "choices": [
    "Faster runners",
    "OIDC short-lived credentials (no stored secrets), signed artifacts, SAST/DAST gates, least-privilege runners, audit logs",
    "More pipelines",
    "Public runners for speed"
   ],
   "answer": 1,
   "explain": "Pipeline security = identity (OIDC), supply chain (signing, gates), least privilege, auditability."
  }
 ],
 "scenarios": [
  {
   "id": "il-14-scn-sev1",
   "title": "Incident command: sev-1 checkout outage",
   "context": "02:14. Pager: checkout error rate 40% and climbing. You’re the on-call SRE and incident commander.",
   "steps": [
    {
     "prompt": "First action in the opening minutes?",
     "options": [
      {
       "text": "Declare the incident, assume IC, open the bridge and the #incident channel",
       "correct": true,
       "why": "Command before debugging: declaring focuses the response, the bridge gathers experts, and the IC coordinates instead of keyboard-diving."
      },
      {
       "text": "SSH in and start debugging the checkout service alone",
       "correct": false,
       "why": "Solo debugging abandons command — nobody coordinates, comms go silent, and parallel work collides."
      },
      {
       "text": "Page the entire engineering org immediately",
       "correct": false,
       "why": "Paging everyone is noise; page the service owners and scale only if the blast radius demands it."
      },
      {
       "text": "Wait 10 minutes to see if it recovers on its own",
       "correct": false,
       "why": "40% errors and climbing is user harm now; waiting converts an incident into a longer incident."
      }
     ]
    },
    {
     "prompt": "Five minutes in, no mitigation yet. What do you communicate?",
     "options": [
      {
       "text": "Post impact-first updates to #incident every ~15 minutes: who’s affected, what we’re doing, when the next update lands",
       "correct": true,
       "why": "Cadenced, impact-first comms prevent the second outage (confusion); ‘no update’ is itself an update."
      },
      {
       "text": "Stay silent until there’s a fix to announce",
       "correct": false,
       "why": "Silence during an outage breeds rumors and duplicate escalations — comms is part of the response."
      },
      {
       "text": "Post raw stack traces and theories as they occur",
       "correct": false,
       "why": "Unfiltered debugging noise confuses stakeholders; the comms role translates signal for the audience."
      },
      {
       "text": "Email the CEO directly with early speculation",
       "correct": false,
       "why": "Escalation without facts creates pressure without progress; comms goes through the incident channel."
      }
     ]
    },
    {
     "prompt": "You suspect the 02:00 deploy. Mitigation vs root cause — what now?",
     "options": [
      {
       "text": "Roll back the deploy first (mitigate), investigate the root cause after traffic recovers",
       "correct": true,
       "why": "Mitigate first, understand second: every minute of 40% errors is user harm, and the rollback is the fastest hypothesis test."
      },
      {
       "text": "Find the exact root cause before touching anything",
       "correct": false,
       "why": "Diagnosis-before-mitigation maximizes outage duration; the incident lifecycle puts mitigation first."
      },
      {
       "text": "Scale up the checkout pods — more capacity fixes everything",
       "correct": false,
       "why": "Scaling a broken deploy multiplies the brokenness; capacity treats a symptom you haven’t diagnosed."
      },
      {
       "text": "Restart all pods simultaneously",
       "correct": false,
       "why": "A full restart is a full outage during the restart — and it destroys the evidence you need."
      }
     ]
    },
    {
     "prompt": "The incident is resolved. What makes the postmortem useful?",
     "options": [
      {
       "text": "Blameless timeline, plural root causes, and action items with owners and dates",
       "correct": true,
       "why": "Blamelessness gets honest data; owned action items are the postmortem’s actual product — the document is just the vehicle."
      },
      {
       "text": "A detailed account of who made the bad deploy",
       "correct": false,
       "why": "Blame produces cover stories in future incidents; systems and process are the fixable units."
      },
      {
       "text": "A brief ‘all good now’ note to close the ticket",
       "correct": false,
       "why": "No learning, no action items — the same incident will recur on schedule."
      },
      {
       "text": "Only the timeline, no action items",
       "correct": false,
       "why": "A timeline without action items is a history lesson; prevention requires owned follow-through."
      }
     ]
    }
   ]
  },
  {
   "id": "il-14-scn-cicd-tradeoff",
   "title": "Design round: deployment pipeline",
   "context": "‘Design the CI/CD pipeline for our user-facing API.’ The interviewer wants decisions, not a tool list.",
   "steps": [
    {
     "prompt": "Deployment strategy for the user-facing API?",
     "options": [
      {
       "text": "Canary: small % first, promote on error-rate/latency gates, automated rollback",
       "correct": true,
       "why": "Progressive exposure with metric gates bounds blast radius — the right default for user-facing services."
      },
      {
       "text": "Big-bang deploy to all instances at once — fastest",
       "correct": false,
       "why": "Fastest to deploy, fastest to outage: 100% of users meet every bad release simultaneously."
      },
      {
       "text": "Manual SCP of binaries to each server",
       "correct": false,
       "why": "Unauditable, unrepeatable, unrollbackable — the opposite of a pipeline."
      },
      {
       "text": "Deploy on Fridays to get it over with",
       "correct": false,
       "why": "Timing theater instead of safety engineering; the strategy should make any day safe."
      }
     ]
    },
    {
     "prompt": "Where do security scans go?",
     "options": [
      {
       "text": "In CI, blocking merge on critical findings — shift-left",
       "correct": true,
       "why": "Vulnerabilities found at commit time are cheapest to fix; blocking the merge makes the gate mechanical."
      },
      {
       "text": "After deploy, scanned in production",
       "correct": false,
       "why": "Scanning prod finds vulnerabilities you’ve already shipped to attackers."
      },
      {
       "text": "Once a year during the audit",
       "correct": false,
       "why": "Annual scanning leaves 364 days of unexamined changes — security theater."
      },
      {
       "text": "Nowhere — developers are trusted",
       "correct": false,
       "why": "Trust isn’t a control; even excellent developers ship vulnerable dependencies unknowingly."
      }
     ]
    },
    {
     "prompt": "The interviewer asks: ‘how do you roll back?’",
     "options": [
      {
       "text": "One command redeploys the previous immutable artifact; DB migrations are backward-compatible (expand-contract)",
       "correct": true,
       "why": "Rollback is only real if it’s rehearsed, one command, and the data layer tolerates the old code."
      },
      {
       "text": "‘We’d fix forward — rollbacks are for the weak’",
       "correct": false,
       "why": "Fix-forward during an active outage gambles user impact on debugging speed."
      },
      {
       "text": "Restore from last night’s backup",
       "correct": false,
       "why": "Backup restore loses all data since the backup and takes far longer than an artifact rollback."
      },
      {
       "text": "We’ve never needed to roll back",
       "correct": false,
       "why": "‘Never needed’ usually means ‘never tested’ — an untested rollback plan is a hope."
      }
     ]
    }
   ]
  },
  {
   "id": "il-14-scn-ops-war-story",
   "title": "Behavioral: ‘Tell me about an outage you handled’",
   "context": "The SRE behavioral round. They want the war story — told like an SRE.",
   "steps": [
    {
     "prompt": "Which story do you pick?",
     "options": [
      {
       "text": "One with real user impact where your decisions mattered — stakes, your calls, the outcome",
       "correct": true,
       "why": "Impact + your decisions = gradable evidence of judgment under pressure."
      },
      {
       "text": "The funniest outage, regardless of your role in it",
       "correct": false,
       "why": "Entertainment isn’t evidence; if you were a bystander, there’s nothing to score."
      },
      {
       "text": "A story where everything went perfectly",
       "correct": false,
       "why": "Frictionless stories reveal nothing about how you handle pressure or ambiguity."
      },
      {
       "text": "Someone else’s outage you heard about",
       "correct": false,
       "why": "Secondhand stories can’t demonstrate your behavior — interviewers score you, not your anecdotes."
      }
     ]
    },
    {
     "prompt": "You made a wrong call mid-incident (restarted the wrong tier). How do you tell it?",
     "options": [
      {
       "text": "Name it plainly: what you did, what it cost, what you changed in the runbook after",
       "correct": true,
       "why": "Owning mistakes with a systemic fix is the blameless-culture signal SRE teams hire for."
      },
      {
       "text": "Leave it out — the story is cleaner without it",
       "correct": false,
       "why": "Sanitized stories read as fiction; the wrong turn is where the learning — and the score — lives."
      },
      {
       "text": "Blame the misleading dashboard",
       "correct": false,
       "why": "Blame, even of a tool, fails the ownership test; the fix belongs to the system, including you."
      },
      {
       "text": "Say you’d do everything the same again",
       "correct": false,
       "why": "No-learning answers signal no growth — the opposite of what the question probes."
      }
     ]
    },
    {
     "prompt": "How do you close the story?",
     "options": [
      {
       "text": "The lesson as a changed practice: ‘now our runbook has X, and it caught Y last month’",
       "correct": true,
       "why": "A lesson with evidence it stuck turns a story into proof of growth."
      },
      {
       "text": "‘And that’s why I’m great under pressure’",
       "correct": false,
       "why": "Self-praise conclusions sound hollow; let the evidence make the claim."
      },
      {
       "text": "Trail off after the resolution",
       "correct": false,
       "why": "No landing wastes the story’s arc — the lesson is the point."
      },
      {
       "text": "Ask if they’ve had similar outages",
       "correct": false,
       "why": "Deflecting at the close surrenders the final impression; land your lesson first."
      }
     ]
    }
   ]
  }
 ],
