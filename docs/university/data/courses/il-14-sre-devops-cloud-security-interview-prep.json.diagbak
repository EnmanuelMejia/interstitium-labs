    {
     "id": "devops-interview-prep--devops-containers--drill-applied",
     "title": "Applied reps: Containers and Orchestration",
     "items": [
      {
       "prompt": "Applied check: Putting dependency install before code copy in a Dockerfile:",
       "answer": "Maximizes layer cache hits — slow-changing steps cache, fast-changing code rebuilds cheaply",
       "explain": "Cache order is the Dockerfile's performance story — the Hands-on procedure step 1."
      },
      {
       "prompt": "Applied check: A Pod stuck in Pending most often means:",
       "answer": "No schedulable node or insufficient resources for its requests",
       "explain": "Pending = the scheduler can't place it: resources, taints, or affinity — triage from the Concepts."
      },
      {
       "prompt": "Applied check: Running containers as root inside the image is discouraged because:",
       "answer": "A container escape then runs as root on the host — least privilege applies inside containers too",
       "explain": "Defense in depth: non-root users contain the blast radius of an escape."
      },
      {
       "prompt": "Applied check: ConfigMaps vs Secrets: the real distinction is:",
       "answer": "Secrets hold sensitive values with access controls — but both are just Kubernetes objects, and Secrets are only base64, not encrypted",
