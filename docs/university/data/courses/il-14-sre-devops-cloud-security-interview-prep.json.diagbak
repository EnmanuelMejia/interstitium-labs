   "id": "devops-interview-prep--devops-troubleshoot",
   "mockTask": {
    "id": "devops-interview-prep--devops-troubleshoot--mock",
    "type": "choice",
    "q": "CrashLoopBackOff most often means:",
    "choices": [
     "Network partition",
     "DNS outage",
     "The container starts then exits — bad command, missing config, or failing startup probe",
     "Node failure"
    ],
    "answer": 2,
    "explain": "The kubelet keeps retrying a container that can’t stay alive; describe/events reveal why it dies."
