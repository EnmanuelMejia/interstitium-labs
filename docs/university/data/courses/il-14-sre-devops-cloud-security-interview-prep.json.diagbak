   "handsOnLab": {
    "id": "devops-interview-prep--devops-troubleshoot--lab",
    "title": "Operator's brief: Troubleshooting Under Pressure",
    "brief": "You will write the artifacts a real operator would produce for Troubleshooting Under Pressure — incident review, SLO spec, and tradeoff analysis — because interviews probe the seams.",
