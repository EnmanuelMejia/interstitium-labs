   "handsOnLab": {
    "id": "cloud-interview-prep--cloud-security-controls--lab",
    "title": "Operator's brief: Cloud Security Controls",
    "brief": "You will write the artifacts a real operator would produce for Cloud Security Controls — incident review, SLO spec, and tradeoff analysis — because interviews probe the seams.",
    "steps": [
     "Write a blameless incident review for a realistic Cloud Security Controls failure: timeline, impact in numbers, detection, response, root cause, action items with owners.",
     "Specify the SLOs: indicators, objectives, error budget, and what consumes the budget — with the math shown.",
     "Draw the architecture and annotate every tradeoff: what you chose, what you gave up, why it was worth it.",
     "Write the runbook excerpt: the alert, the first five diagnostic commands, the escalation path.",
     "Prepare the war story: a three-minute telling with numbers, your decisions, and what you'd do differently.",
     "Peer-review the brief as a hiring manager: which claims have evidence, which are buzzwords?"
    ],
    "deliverable": "incident-review.md, slo-spec.md (with math), architecture tradeoffs, runbook excerpt, and war-story script for Cloud Security Controls.",
    "checkpoint": "Incident review has numbers and owned action items; SLO math is shown; every architecture choice names its tradeoff; war story runs three minutes."
   },
   "id": "cloud-interview-prep--cloud-security-controls",
   "mockTask": {
    "id": "cloud-interview-prep--cloud-security-controls--mock",
    "type": "choice",
    "q": "Baking secrets into container images is wrong because:",
    "choices": [
     "Anyone with registry access gets the secrets — images are widely shared artifacts",
     "Secrets expire",
     "It’s slow",
     "Images are large"
    ],
    "answer": 0,
