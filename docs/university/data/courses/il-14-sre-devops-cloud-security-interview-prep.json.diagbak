   "id": "security-eng-interview-prep--sec-crypto",
   "mockTask": {
    "id": "security-eng-interview-prep--sec-crypto--mock",
    "type": "choice",
    "q": "Math.random() is unfit for security tokens because:",
    "choices": [
     "It’s a predictable PRNG — outputs can be reconstructed by attackers",
     "It needs seeding",
