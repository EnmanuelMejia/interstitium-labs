   "drills": [
    {
     "id": "cloud-interview-prep--cloud-concepts--drill-recall",
     "title": "Recall sprint: Core Cloud Concepts",
     "items": [
      {
       "prompt": "From memory, in one or two sentences: Vendor-neutral vs vendor-specific knowledge?",
