   "id": "tech-mock-interview-circuit--mock-sysdesign",
   "mockTask": {
    "id": "tech-mock-interview-circuit--mock-sysdesign--mock",
    "type": "choice",
    "q": "Asking ‘what breaks first at 10x’ is the right question because:",
    "choices": [
     "It forces ordered thinking about limits instead of vague ‘it scales’ claims",
     "It’s dramatic",
