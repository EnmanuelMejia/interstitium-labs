 "_phase2_done": true,
 "glossary": [
  {
   "term": "SLI",
   "definition": "Service Level Indicator: the measured quantity (e.g., proportion of successful requests)."
  },
  {
   "term": "SLO",
   "definition": "Service Level Objective: target SLI value over a window (99.9% / 30d)."
  },
  {
   "term": "Error budget",
   "definition": "1 − SLO: the allowed unreliability, spent on velocity or conserved for stability."
  },
  {
   "term": "Burn rate",
   "definition": "Rate of error-budget consumption relative to elapsed time; basis for paging vs ticket alerts."
  },
  {
   "term": "Blameless postmortem",
   "definition": "Incident review focused on systemic causes and action items, never individual blame."
  },
  {
   "term": "Incident commander",
   "definition": "The coordinator role in incident response: runs the process, doesn't type the fix."
  },
  {
   "term": "Toil",
   "definition": "Manual repetitive ops work; SRE caps it and automates the remainder."
  },
  {
   "term": "RED / USE",
   "definition": "Monitoring methods: RED (Rate, Errors, Duration) for services; USE (Utilization, Saturation, Errors) for resources."
  },
  {
   "term": "Canary",
   "definition": "Releasing to a small traffic fraction first, promoting on health signals."
  },
  {
   "term": "Feature flag",
   "definition": "Runtime toggle decoupling deploy from release; the fastest incident mitigation lever."
  },
  {
   "term": "Runbook",
   "definition": "Step-by-step operational procedure for a known failure mode — tested, not aspirational."
  },
  {
   "term": "Game day",
   "definition": "Practiced failure injection (chaos engineering lite) to validate runbooks and response."
  }
 ],
 "faq": [
  {
   "q": "SRE vs DevOps — what's the interview distinction?",
   "a": "DevOps: culture + CI/CD + automation practices. SRE: DevOps' engineering discipline with SLOs, error budgets, and toil caps. Interviewers want you to use the terms precisely."
  },
  {
   "q": "How do I answer 'tell me about a time you caused an outage'?",
   "a": "Own it with the postmortem structure: impact, timeline, your actions, contributing factors, what changed (with owners). Blameless framing shows seniority."
  },
  {
   "q": "What's the troubleshooting rubric?",
   "a": "Mental model stated → hypothesis → bisect by evidence → change correlation → mitigation before root cause → verification. Narrate every step aloud."
  },
  {
   "q": "Do I need to memorize the budget table?",
   "a": "Know 99.9% (43m) and 99.99% (4.4m) cold; derive the rest. Interviewers test whether you can *use* the budget in a policy discussion."
  },
  {
   "q": "How technical should the security portion go?",
   "a": "App/network/crypto fundamentals plus pipeline supply-chain security. You're interviewing as a defender who ships, not as a pentester."
  },
  {
   "q": "What are the mock circuits?",
   "a": "Full timed loops: DSA speed reps, system-design reps, troubleshooting narration, behavioral — scored against rubrics, with weak-spot triage between rounds."
  }
 ],
 "tips": [
  "Follow the guided path in order — each module unlocks the next. The sequence is the curriculum; skipping ahead breaks the chain.",
  "This course maps to Certified Kubernetes Administrator (CKA) and AWS Certified DevOps Engineer – Professional (DOP-C02) (independent preparation — no affiliation). Weight your drill time toward the heaviest exam domains shown in the cert gates.",
  "The math modules (Probability & Statistics, Logic & Boolean Algebra, Cryptography in Practice) are load-bearing — finish them before the applied modules that assume them.",
  "Quiz-gated modules need 70%+ to unlock the next. When you miss a question, ask Noah to walk you through the miss Socratically before re-attempting.",
  "Do each hands-on lab twice — once following the guide, once from a blank screen. The second pass is where the skill sticks.",
  "This is a 178-hour course: at 10 focused hours a week it takes about 4 months. Short daily sessions beat weekend cramming — pace it like a semester."
 ],
 "legends": {
  "✓ Complete": "Module finished — marked complete by you, or auto-marked when you scrolled the whole module.",
  "✓ Mastered": "Module finished AND its quiz mastery gate passed (score of 70% or higher).",
  "✓ Tested out": "Placed out via the diagnostic — counts as passed without completing the module.",
  "● You are here": "Your current position in the guided sequence.",
  "→ Up next": "The next module in the sequence — unlocks when the current lesson is passed.",
  "🔒 Locked": "Complete the previous lesson to unlock this module.",
  "⚠ Mastery gate": "This module has a quiz gate — score 70% or higher to pass and unlock the next module.",
  "Readiness ring": "Brief tab — your overall preparedness across this course's objectives, computed from completions and quiz scores.",
  "Noah": "Noah AI — your Socratic tutor. Ask with a hypothesis; it guides with questions before answers, grounded in this course.",
  "Continue where you left off": "Resume banner — jumps to the exact module you last opened, on this device.",
  "Next →": "End-of-module button — advances to the next module in the guided sequence (disabled until the current lesson is passed).",
  "Mark module complete": "Module footer button — records the module as done in your progress.",
  "FREE / lock badge": "Academy catalog — FREE means open to everyone; the lock means the course needs purchase (checkout)."
 }
}