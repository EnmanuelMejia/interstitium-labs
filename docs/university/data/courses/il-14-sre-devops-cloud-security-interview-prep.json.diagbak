 "terminalSims": [
  {
   "id": "sre-triage-terminal",
   "title": "SRE triage terminal",
   "brief": "Practice the troubleshooting module's command set — pod triage, log filtering, and layer-by-layer network bisection — against a realistic sandbox.",
   "prompt": "learner@il:~$",
   "commands": [
    {
     "cmd": "kubectl get pods",
     "out": "NAME                     READY   STATUS             RESTARTS   AGE\ncheckout-api-7d9f8c6b   0/1     CrashLoopBackOff   12         34m\ncheckout-api-6a1b2d4e   1/1     Running            0          34m\npayments-5f7c9a1b       1/1     Running            0          2h"
    },
    {
     "cmd": "kubectl describe pod checkout-api-7d9f8c6b",
     "out": "Events:\n  Warning  BackOff    3m  kubelet  Back-off restarting failed container\n  Warning  Failed     2m  kubelet  Error: failed to start container: missing env CHECKOUT_DSN"
    },
    {
     "cmd": "kubectl logs checkout-api-7d9f8c6b --tail 5",
     "out": "FATAL: env var CHECKOUT_DSN is not set\nexiting: configuration invalid"
    },
    {
     "cmd": "curl -v https://api.example.internal/health",
     "out": "* Could not resolve host: api.example.internal\n* Closing connection"
    },
    {
     "cmd": "dig api.example.internal",
     "out": "; <<>> DiG <<>> api.example.internal\n;; status: NXDOMAIN"
    },
    {
     "cmd": "kubectl rollout undo deployment/checkout-api",
     "out": "deployment.apps/checkout-api rolled back"
    },
    {
     "cmd": "help",
     "out": "kubectl get pods | kubectl describe pod <name> | kubectl logs <pod> --tail 5 | curl -v <url> | dig <host> | kubectl rollout undo deployment/<name>"
    }
   ]
  },
  {
   "id": "pipeline-cli-terminal",
   "title": "Pipeline & cloud CLI terminal",
   "brief": "Rehearse the DevOps and cloud modules' CLI surface — git, containers, Terraform plans, and Helm releases — in a safe sandbox.",
   "prompt": "learner@il:~/platform$",
   "commands": [
    {
     "cmd": "git status",
     "out": "On branch main\nnothing to commit, working tree clean"
    },
    {
     "cmd": "docker build -t checkout-api:abc1234 .",
     "out": " => [internal] load build definition\n => [auth] sharing credentials for registry\n => exporting to image\n => naming to docker.io/library/checkout-api:abc1234"
    },
    {
     "cmd": "terraform plan -out plan.tfplan",
     "out": "Plan: 3 to add, 0 to change, 0 to destroy.\nSaved the plan to: plan.tfplan"
    },
    {
     "cmd": "helm list",
     "out": "NAME          \tNAMESPACE\tREVISION\tSTATUS  \ncheckout-api\tprod     \t12      \tdeployed"
    },
    {
     "cmd": "kubectl get ingress",
     "out": "NAME           CLASS   HOSTS                 ADDRESS\ncheckout-ing   nginx   shop.example.com      203.0.113.10"
    },
    {
     "cmd": "help",
     "out": "git status | docker build -t <tag> . | terraform plan -out plan.tfplan | helm list | kubectl get ingress"
    }
   ]
  }
 ],
