  "certGates": [],
  "_noCertNote": "No accredited certification exists for Western esotericism; this course is independent scholarship. No certification track is mapped rather than inventing one.",
  "_phase2_done": true,
  "glossary": [
    {
      "term": "Tier discipline",
      "definition": "The course's method for sorting claims into documented fact, scholarly consensus, practitioner claim, and popular myth before arguing about them."
    },
    {
      "term": "Emic / etic",
      "definition": "Emic: describing a tradition in its own terms and logic. Etic: describing it from an external scholarly standpoint. The course requires keeping the two distinct."
    },
    {
      "term": "Corpus Hermeticum",
      "definition": "Collection of Graeco-Egyptian philosophical dialogues (c. 100\u2013300 CE) attributed to Hermes Trismegistus; foundation text of the Hermetic current."
    },
    {
      "term": "Prisca theologia",
      "definition": "The Renaissance idea of an ancient, single theology underlying all religions \u2014 the frame through which Ficino and others read the Hermetica."
    },
    {
      "term": "Monas Hieroglyphica",
      "definition": "John Dee's 1564 glyph unifying astronomy, geometry, and alchemy in a single symbol; his most concentrated esoteric statement."
    },
    {
      "term": "Enochian",
      "definition": "The angelic language and tabular system recorded in Dee and Kelley's spirit diaries (1582\u20131589): 49 Tables, the Great Table, and the 19 Calls."
    },
    {
      "term": "Scryer",
      "definition": "The medium who 'sees' spirits \u2014 Edward Kelley's role in the Dee workings; Dee himself acted as recorder and interrogator."
    },
    {
      "term": "Heptarchia Mystica",
      "definition": "Dee's system of the 49 'good angels' governing the days of the week, derived from the Enochian workings."
    },
    {
      "term": "Liber Loagaeth",
      "definition": "'Book of Speech from God': 49 letter-squares dictated through Kelley, never fully decoded in Dee's lifetime."
    },
    {
      "term": "Golden Dawn",
      "definition": "The Hermetic Order of the Golden Dawn (1888\u20131903): the ritual-magic order that systematized grades, Tarot correspondences, and Enochian magic for the modern occult revival."
    },
    {
      "term": "Chaos magic",
      "definition": "Late-20th-century current (Spare, Carroll, Sherwin) treating belief as a tool: sigilization, gnosis states, and paradigm shifting."
    },
    {
      "term": "Hyperstition",
      "definition": "CCRU concept: fiction that makes itself real by engineering the conditions of its own truth."
    },
    {
      "term": "Numogram",
      "definition": "The CCRU's diagrammatic engine of decimal digits arranged in zones and currents \u2014 a documented artifact of 1990s Warwick theory-fiction."
    },
    {
      "term": "Cybersyn",
      "definition": "Chile's 1971\u201373 cybernetic economic-management system under Stafford Beer: telex network, real-time models, and the Opsroom."
    },
    {
      "term": "Viable System Model",
      "definition": "Stafford Beer's cybernetic model of organizational viability (Systems 1\u20135); the design basis of Cybersyn."
    },
    {
      "term": "Theory-fiction",
      "definition": "The CCRU's genre: philosophical writing that operates as fiction and as theory simultaneously."
    },
    {
      "term": "Reception history",
      "definition": "How a text or figure was read across time \u2014 e.g., Casaubon's 1659 framing of Dee as deluded vs. modern scholarship's natural-philosopher reading."
    },
    {
      "term": "Source criticism",
      "definition": "Evaluating a source's provenance, witnesses, and interests before accepting its claims \u2014 applied here to diaries, manifestos, and lineage stories."
    }
  ],
  "faq": [
    {
      "q": "Does this course teach me to practice magic?",
      "a": "No. It teaches you to *study* esoteric traditions with documentary discipline \u2014 reading primary texts, sorting claims by tier, and tracing histories. Practitioner perspectives are read emically (in their own logic) but nothing here is ritual instruction."
    },
    {
      "q": "Why study Dee and the CCRU in the same course as Hermeticism?",
      "a": "The course traces one current: Alexandria \u2192 Renaissance Hermetica \u2192 Dee \u2192 Golden Dawn \u2192 chaos magic \u2192 the CCRU's cybernetic remix. Each stage reworks the previous one's symbols with new technology of the day."
    },
    {
      "q": "Is the Enochian language 'real'?",
      "a": "The *manuscripts* are real (British Library, Sloane MSS) \u2014 Tier 1. Whether angels dictated the language is the practitioner's Tier-3 claim. Linguists note Enochian has genuine internal structure; that doesn't settle its origin. The course keeps those questions separate."
    },
    {
      "q": "Was Cybersyn actually built, or is it a myth?",
      "a": "Built. Chile's government ran a working telex-based economic monitoring network with an operations room in 1971\u201373, designed by Stafford Beer's team. Eden Medina's *Cybernetic Revolutionaries* (2011) documents it from archives."
    },
    {
      "q": "What's the difference between hyperstition and superstition?",
      "a": "Superstition is belief without mechanism. Hyperstition, in CCRU usage, is a *productive* fiction \u2014 a story, diagram, or program that participates in bringing about what it describes. It's a concept for analysis, not a spell."
    },
    {
      "q": "How do I cite an esoteric primary text properly?",
      "a": "Manuscript: repository + shelfmark + folio. Print: author, title, place, printer, date. Modern edition: editor, publisher, year. Never cite a forum summary when the primary text is available \u2014 go to the artifact."
    },
    {
      "q": "The math modules feel out of place. Why are they here?",
      "a": "Boolean algebra and modular arithmetic are the shared spine across IL-01 through IL-04, and they do real work here: Enochian tables are combinatorics, the numogram is modular arithmetic on digits, and Cybersyn is control theory. The math is the load-bearing structure."
    },
    {
      "q": "How is this course graded \u2014 I mean, how do I know I'm getting it?",
      "a": "Self-check: can you take any esoteric claim and (1) assign its tier, (2) name its primary source, (3) state the emic and etic readings separately, and (4) identify who benefits from believing it? If yes, the method has landed."
    }
  ],
