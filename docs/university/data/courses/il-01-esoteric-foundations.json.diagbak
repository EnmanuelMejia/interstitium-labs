  "honestyNote": "Original study material only \u2014 questions, labs, and scenarios are authored for this course. Interstitium Labs confers no certificate and is not affiliated with any esoteric order or academic institution. Tier labels reflect the course's historiographic method; contested topics are presented as contested. No belief is required or tested.",
  "terminalSims": [
    {
      "id": "il01-tiering-terminal",
      "title": "The Tiering Terminal",
      "brief": "Practice the tier discipline at the command line \u2014 query the academy\u2019s tiers, dates, and figures. Every answer restates this course\u2019s own material.",
      "prompt": "learner@il:tier$",
      "commands": [
        {
          "cmd": "help",
          "out": "commands: tiers | corpus | casaubon | dee | monas | cybersyn | hyperstition | journal | honesty"
        },
        {
          "cmd": "tiers",
          "out": "DOCUMENTED \u2014 primary sources, artifacts, dated texts. | SCHOLARLY CONSENSUS \u2014 what historians agree on, provisional and cited. | TRADITIONAL \u2014 what lineages claim about themselves, reported not endorsed. | CONTESTED \u2014 open questions and rival readings."
        },
        {
          "cmd": "corpus",
