      "id": "il01-m11",
      "type": "code",
      "prompt": "Write tier_claim('The diaries span 1581-1589', 'the diaries exist in archives') and print the result.",
      "starter": "# reuse the lab's tier_claim",
      "required": [
        "def tier_claim",
        "return",
        "print"
      ],
      "answer": "def tier_claim(claim, evidence):\n    ev=evidence.lower()\n    if any(k in ev for k in ('manuscript','archive','exists','dated','philology')):\n        return ('DOCUMENTED', evidence)\n    return ('CONTESTED', evidence)\nprint(tier_claim('The diaries span 1581-1589','the diaries exist in archives'))",
      "explain": "Artifact evidence \u2192 DOCUMENTED."
    },
