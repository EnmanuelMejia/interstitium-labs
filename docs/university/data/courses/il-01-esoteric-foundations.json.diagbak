  "scenarios": [
    {
      "id": "il01-scn-tier",
      "title": "The Tiering Dispute",
      "context": "A forum claims: 'The Golden Dawn's rituals come from ancient Egypt \u2014 it's DOCUMENTED.' You respond.",
      "steps": [
        {
          "prompt": "Your move?",
          "options": [
            {
              "text": "Agree \u2014 tradition says so",
              "correct": false,
              "why": "Tradition saying so makes it TRADITIONAL, not DOCUMENTED."
            },
            {
              "text": "Tier it: the 1888\u20131903 papers are DOCUMENTED; the Egyptian origin is TRADITIONAL/CONTESTED \u2014 separate claims, separate tiers",
              "correct": true,
              "why": "The method: tier each claim separately. Papers documented; origins contested."
            }
          ]
        },
        {
          "prompt": "They reply: 'Casaubon was wrong.' Your standard?",
          "options": [
            {
              "text": "Debate endlessly",
              "correct": false,
              "why": "Argument without evidence standards is noise."
            },
            {
              "text": "Ask for the tier: what primary evidence, what scholarly consensus, what's contested \u2014 then read it",
              "correct": true,
              "why": "The tier discipline turns disputes into research programs."
            }
          ]
        }
      ]
    },
    {
      "id": "il01-scn-cybersyn",
      "title": "The Cybersyn Briefing",
      "context": "A founder wants 'Cybersyn for our startup' \u2014 an ops room with screens, VSM-inspired. Brief them honestly.",
      "steps": [
        {
          "prompt": "Your briefing?",
          "options": [
            {
              "text": "Build the ops room \u2014 vibes are enough",
