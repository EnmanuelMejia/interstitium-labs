      "cards": [
        {
          "front": "gcd(48, 180) = ?",
          "back": "**12** \u2014 via Euclid's algorithm."
        },
        {
          "front": "Inverse of 17 mod 26?",
          "back": "**23** \u2014 since 17\u00d723 \u2261 1 (mod 26)."
        },
        {
          "front": "When does a have an inverse mod m?",
          "back": "Exactly when gcd(a,m) = 1."
        },
        {
          "front": "\u03c6(26) = ?",
          "back": "**12** \u2014 count of k \u2264 26 coprime to 26."
        },
        {
          "front": "Euler's theorem?",
          "back": "gcd(a,m)=1 \u2192 a^\u03c6(m) \u2261 1 (mod m)."
        },
        {
          "front": "Toy RSA: n for p=61, q=53?",
          "back": "n = **3233**, \u03c6(n) = **3120**."
        },
        {
          "front": "100 mod 26?",
          "back": "**22**."
        },
        {
          "front": "Why must e be coprime to \u03c6(n) in RSA?",
          "back": "So the inverse d = e^(\u22121) mod \u03c6(n) exists."
        },
        {
          "front": "Solve 17x \u2261 5 (mod 26).",
          "back": "x \u2261 **11** (mod 26)."
        },
        {
          "front": "Prime factorization of 180?",
          "back": "2\u00b2 \u00d7 3\u00b2 \u00d7 5."
        },
        {
          "front": "Trial division bound for testing n?",
          "back": "Primes up to \u221an suffice."
        },
        {
          "front": "3^12 mod 26?",
          "back": "**1** \u2014 Euler's theorem predicts 1."
        }
      ],
