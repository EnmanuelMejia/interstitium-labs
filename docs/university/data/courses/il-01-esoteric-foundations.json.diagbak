        "print",
        "sorted("
      ],
      "answer": "stop={'the','and','for','was','all','are','that','with'}\np={'asclepius':'god is the glory of all things','poimandres':'the light was the mind of god'}\ns=lambda t:{w for w in t.split() if len(w)>3 and w not in stop}\nprint(sorted(s(p['asclepius'])&s(p['poimandres'])))",
      "explain": "Concordance: shared vocabulary maps the current."
    }
