          ]
        },
        {
          "prompt": "They ask what to read first?",
          "options": [
            {
              "text": "The memes",
              "correct": false,
              "why": "Start with the theory, not the legend."
            },
            {
              "text": "Beer on the viable system model \u2014 the management cybernetics under the legend, then the documented history",
              "correct": true,
              "why": "Theory first, then history, then the mythologized layer \u2014 tiered reading order."
            }
          ]
        }
      ]
    }
  ],
