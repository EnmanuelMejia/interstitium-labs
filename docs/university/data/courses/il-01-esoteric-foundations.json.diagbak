      "drills": [
        {
          "title": "Modular arithmetic reps",
          "items": [
            {
              "prompt": "Compute 38 mod 26.",
              "answer": "12",
              "explain": "38 \u2212 26 = 12."
            },
            {
              "prompt": "Compute (17\u00d75) mod 26.",
              "answer": "7",
              "explain": "85 = 3\u00d726 + 7."
            },
            {
              "prompt": "gcd(17, 26)?",
              "answer": "1",
              "explain": "17 is prime, not dividing 26."
            },
            {
              "prompt": "\u03c6(10)?",
              "answer": "4",
              "explain": "Coprime to 10: 1,3,7,9 \u2192 4."
            }
          ],
          "id": "il-01-esoteric-foundations-math-numtheory--drill-1"
        },
        {
          "title": "RSA mechanics reps",
          "items": [
            {
              "prompt": "Toy RSA: given e=17, \u03c6=3120, d=2753. Verify e\u00b7d mod \u03c6.",
              "answer": "1",
              "explain": "17\u00d72753 mod 3120 = 1 \u2713."
            },
            {
              "prompt": "Why can RSA use small e like 17 but never small d?",
              "answer": "Small d enables attacks; e only needs coprimality",
              "explain": "d must stay secret and large; e is public."
            },
            {
              "prompt": "Encrypt m=7 with e=17, n=3233.",
              "answer": "2369",
              "explain": "7^17 mod 3233 = 2369."
            },
            {
              "prompt": "What breaks if p = q in RSA?",
              "answer": "n = p\u00b2 reveals p = \u221an",
              "explain": "Factoring becomes trivial square root."
            }
          ],
          "id": "il-01-esoteric-foundations-math-numtheory--drill-2"
        }
      ],
      "estimatedMinutes": 345,
      "handsOnLab": {
        "title": "Implement toy RSA and verify the round-trip",
        "brief": "You will implement key generation, encryption, and decryption for the toy RSA parameters in Python, verifying every number in this module independently.",
        "steps": [
          "Write egcd(a,b) returning (g,x,y) with ax+by=g; assert egcd(48,180)[0]==12.",
          "Write modinv(a,m) via egcd; assert modinv(17,26)==23 and (17*23)%26==1.",
          "Write phi(m) by counting coprimes; assert phi(26)==12.",
          "Generate the toy key: p=61,q=53,e=17; compute n, phi, d; assert (e*d)%phi==1.",
          "Encrypt and decrypt several messages; assert decrypt(encrypt(m))==m for each.",
          "Break it on purpose: try e=13 (not coprime to phi) and record the failure mode."
        ],
        "deliverable": "rsa_toy.py with asserts plus a note on the e=13 failure.",
        "checkpoint": "All asserts pass; round-trip verified for \u22655 messages; failure mode documented.",
        "id": "il-01-esoteric-foundations-math-numtheory--lab"
      },
      "id": "il-01-esoteric-foundations-math-numtheory",
      "mockTask": {
        "q": "17^(-1) mod 26 = 23. What is 5 \u00d7 17^(-1) mod 26?",
