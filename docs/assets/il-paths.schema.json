{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstitiumlabs.dev/assets/il-paths.schema.json",
  "title": "Interstitium Labs Path Catalog",
  "type": "object",
  "required": [
    "v",
    "updated",
    "paths"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string"
    },
    "honesty": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "peer",
          "exceed",
          "lose",
          "outcome",
          "stages",
          "href"
        ],
        "additionalProperties": true
      }
    }
  }
}
