{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstitiumlabs.dev/assets/il-paths.schema.json",
  "title": "Interstitium Labs Path Catalog",
  "type": "object",
  "required": [
    "v",
    "updated",
    "paths"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string"
    },
    "honesty": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "peer",
          "exceed",
          "lose",
          "outcome",
          "stages",
          "href"
        ],
        "additionalProperties": true,
        "properties": {
          "immersive": {
            "type": "object",
            "description": "3D-first curriculum stage. mode must be 3d-first. engine: three|godot|unreal. asset: procedural:* or /assets/immersive/*.glb",
            "required": [
              "mode",
              "engine",
              "asset"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "const": "3d-first"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "three",
                  "godot",
                  "unreal"
                ]
              },
              "asset": {
                "type": "string"
              },
              "captions": {
                "type": "boolean"
              },
              "fallback": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
