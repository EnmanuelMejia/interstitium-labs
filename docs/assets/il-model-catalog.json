{
  "version": 1,
  "updated": "2026-09-22",
  "policy": "scale_relative_to_demand",
  "defaults": {
    "task": "chat",
    "hardware_profile": "p920-p1000-4gb",
    "demand_tier": "T0",
    "backend_priority": ["ollama", "openai-compat", "llamacpp", "vllm", "lmstudio", "textgen"],
    "base_urls": {
      "ollama": "http://127.0.0.1:11434",
      "openai-compat": "http://127.0.0.1:8000/v1",
      "llamacpp": "http://127.0.0.1:8080/v1",
      "vllm": "http://127.0.0.1:8000/v1",
      "lmstudio": "http://127.0.0.1:1234/v1",
      "textgen": "http://127.0.0.1:5000/v1"
    },
    "routing": {
      "mode": "auto",
      "min_samples": 8,
      "win_rate_margin": 0.08,
      "latency_slack_ms": 1500,
      "explore_ratio": 0.2,
      "healthy_only": true
    },
    "scale_signals": {
      "p95_latency_ms": 8000,
      "error_rate": 0.15,
      "concurrency_hint": 4,
      "thumbs_down_rate": 0.25,
      "window_events": 40
    }
  },
  "demand_tiers": {
    "T0": {
      "id": "T0",
      "label": "Local P920 (single host)",
      "description": "Quadro P1000 4GB GPU for ≤3B Q4/Q5; 7B on dual-Xeon CPU. Never claim 70B local GPU.",
      "hosts": ["p920-host / lab-control"],
      "models_gpu": ["qwen2.5-coder-3b", "phi-3-mini", "llama3.2-3b", "gemma2-2b"],
      "models_cpu": ["qwen2.5-coder-7b", "qwen2.5-7b", "mistral-7b", "deepseek-coder-6.7b"],
      "backends": ["ollama", "llamacpp", "lmstudio", "local-rules"],
      "next_tier": "T1",
      "scale_when": "p95 latency, error rate, or concurrency exceeds T0 thresholds"
    },
    "T1": {
      "id": "T1",
      "label": "Extra CPU inference hosts",
      "description": "Add lab-control peers or dedicated CPU boxes; same OSS weights, more parallel capacity. Still no fake 70B-on-P1000.",
      "hosts": ["p920 + N CPU workers"],
      "models_gpu": ["qwen2.5-coder-3b", "phi-3-mini"],
      "models_cpu": ["qwen2.5-coder-7b", "llama3.1-8b", "qwen2.5-7b", "mistral-7b"],
      "backends": ["ollama", "vllm", "llamacpp", "openai-compat", "local-rules"],
      "next_tier": "T2",
      "scale_when": "T1 saturated; quality needs larger context or remote capacity"
    },
    "T2": {
      "id": "T2",
      "label": "Remote OSS API / bigger GPU later",
      "description": "Operator-configured OpenAI-compatible endpoints for open weights (Together/Groq/Fireworks open models, rented GPU). Keys only in localStorage or lab-control env — never in git. Suggest tier; never auto-buy hardware.",
      "hosts": ["remote OSS API", "rented GPU (future)"],
      "models_gpu": [],
      "models_cpu": ["qwen2.5-7b", "llama3.1-8b", "mistral-7b"],
      "backends": ["together-open", "groq-open", "fireworks-open", "openai-compat", "local-rules"],
      "next_tier": null,
      "scale_when": "Business decision — router only recommends"
    }
  },
  "hardware_profiles": {
    "p920-p1000-4gb": {
      "id": "p920-p1000-4gb",
      "label": "ThinkStation P920 · Quadro P1000 4GB + dual Xeon",
      "vram_gb": 4,
      "ram_gb": 64,
      "default_tier": "T0",
      "honesty": "GPU fits ~3B Q4/Q5 only. Prefer 7B on CPU. Never claim 70B local GPU.",
      "recommend_gpu": ["qwen2.5-coder-3b", "phi-3-mini", "llama3.2-3b"],
      "recommend_cpu": ["qwen2.5-coder-7b", "qwen2.5-7b", "mistral-7b"],
      "forbid_local_gpu": ["qwen2.5-coder-32b", "llama3.1-70b", "mixtral-8x7b"]
    },
    "generic-8gb": {
      "id": "generic-8gb",
      "label": "Generic 8GB VRAM",
      "vram_gb": 8,
      "default_tier": "T0",
      "recommend_gpu": ["qwen2.5-coder-7b", "phi-3-mini", "llama3.1-8b"],
      "recommend_cpu": ["qwen2.5-14b"],
      "forbid_local_gpu": ["llama3.1-70b"]
    }
  },
