<?xml version="1.0" encoding="utf-8"?>
<!--
  Interstitium Labs — Network Security Config (all builds)
  Cleartext disabled everywhere. Debug builds use the copy in
  app/src/debug/res/xml/, which adds a localhost exception; see MOBILE-SECURITY.md.
  Merge into android/app/src/main/res/xml/ after `npx cap add android`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">interstitiumlabs.dev</domain>
    </domain-config>
</network-security-config>
