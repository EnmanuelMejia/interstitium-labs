<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: always dark, no action bar. The Capacitor
         default used Theme.AppCompat.Light.DarkActionBar, which flashed a
         light surface on launch; the brand ground is the void #070B16.
         Fixed dark parent (not DayNight): DayNight follows the system theme
         and could flash a light window on light-mode devices. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Wherever the web view doesn't cover the window, show the void rather
             than the light theme surface: behind the status and navigation bars
             when the system WebView is older than 140 (Capacitor then insets the
             page instead of drawing edge to edge), and for a moment at startup. -->
        <item name="android:windowBackground">@color/il_void</item>
    </style>


    <!-- Launch theme: brand void + centered sigil mark (layer-list), never the
         white Capacitor placeholder. The SplashScreen plugin hides the splash
         explicitly from il-bridge.js once the page is interactive. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/launch_background</item>
    </style>
</resources>