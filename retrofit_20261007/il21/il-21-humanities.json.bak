 "scenarios": [
  {
   "id": "sc-ai-deployment",
   "title": "AI Deployment Ethics Review",
   "context": "Your team built a resume-screening model. It is 12% more 'accurate' than human screeners on historical data, but an audit shows it downgrades resumes with employment gaps — disproportionately affecting caregivers returning to work. Leadership wants to ship Friday.",
   "steps": [
    {
     "prompt": "How do you frame the decision?",
     "options": [
      {
       "text": "Run the three-traditions analysis before deciding: duties, consequences, and character",
       "correct": true,
       "why": "The traditions structure the trade-off instead of letting urgency decide: deontology flags treating applicants as mere means, consequentialism weighs aggregate hiring gains vs. harms, virtue asks what a good craftsperson ships."
      },
      {
       "text": "Ship it — 12% accuracy gain is the only metric that matters",
       "correct": false,
       "why": "Accuracy on biased historical data is not the same as a good hiring decision; the metric begs the question."
      },
      {
       "text": "Kill the project quietly without analysis",
       "correct": false,
       "why": "Avoidance without reasoning teaches the org nothing and may forfeit real benefits a constrained deployment could capture."
      }
     ]
    },
    {
     "prompt": "Analysis done. What do you recommend?",
     "options": [
      {
       "text": "Constrained pilot: remove the gap-penalizing features, add human review of edge cases, instrument outcomes, revisit in 90 days",
       "correct": true,
       "why": "Collingridge-aware: reversible, monitored, humble. It captures value while containing the foreseeable harm — and generates the data a fuller decision needs."
      },
      {
       "text": "Full deployment with a fairness statement on the website",
       "correct": false,
       "why": "A statement doesn't change the model's behavior; this is ethics theater."
      },
      {
       "text": "Hand the decision to legal alone",
       "correct": false,
       "why": "Legal sets the floor, not the ceiling — 'lawful' and 'right' are different questions."
      }
     ]
    }
   ]
  },
  {
   "id": "sc-dual-use",
   "title": "The Dual-Use Dilemma",
   "context": "Your open-source computer-vision library — built for wildlife conservation — is being forked for automated targeting in a conflict zone. Contributors are split: pull the repo, or keep shipping?",
   "steps": [
    {
     "prompt": "First, how do you think about it?",
     "options": [
      {
       "text": "Dual-use analysis: same mechanism, divergent uses — ask which uses, under what controls",
       "correct": true,
       "why": "Neither 'technology is neutral' nor 'ban everything' survives contact with the case; the serious question is always about specific uses and controls."
      },
      {
       "text": "It's neutral — tools have no moral character",
       "correct": false,
       "why": "Affordances shape use; a targeting-ready vision stack is not morally identical to a spreadsheet."
      },
      {
       "text": "Delete the repo immediately",
       "correct": false,
       "why": "Deletion also kills the conservation work and won't un-publish the forks — consequences matter too."
      }
     ]
    },
    {
     "prompt": "What concrete step best fits the analysis?",
     "options": [
      {
       "text": "Keep the conservation core open; gate the targeting-enabling modules behind review, document foreseeable misuse, add a use policy",
       "correct": true,
       "why": "Differentiated controls: preserve the benign use, add friction to the harmful one, document the reasoning — the engineer's four moves."
      },
      {
       "text": "Do nothing — open source means no control",
       "correct": false,
       "why": "License terms, module structure, and documentation are all levers; 'no control' is false."
      },
      {
       "text": "Secretly sabotage the targeting forks",
       "correct": false,
       "why": "Deception violates professional duties and destroys the trust the conservation work depends on."
      }
     ]
    }
   ]
  },
  {
   "id": "sc-writing-pressure",
   "title": "Writing Under Pressure",
   "context": "A Sev-1 outage just ended. You must write the incident review: it will be read by engineers, executives, and possibly a customer. The root cause implicates a shortcut your own team took.",
   "steps": [
    {
     "prompt": "How do you structure it?",
     "options": [
      {
       "text": "BLUF: impact and resolution first, then timeline, root cause (honest), action items with owners",
       "correct": true,
       "why": "Scanners get the essentials in paragraph one; the honest root cause preserves credibility; owned actions make it a tool, not a ritual."
      },
      {
       "text": "Chronological narrative from the first alert",
       "correct": false,
       "why": "Chronology buries the conclusion; busy readers never reach the decisions."
      },
      {
       "text": "Emphasize external factors to protect the team",
       "correct": false,
       "why": "Selective framing is manipulation; blameless review requires honest causation — blame the system, describe it truthfully."
      }
     ]
    },
    {
     "prompt": "How do you phrase the team's shortcut?",
     "options": [
      {
       "text": "State it plainly with the reasoning at the time, then the systemic fix that removes the temptation",
       "correct": true,
       "why": "Honest, blameless, and forward-looking: it names the cause without personal attack and fixes the incentive."
      },
      {
       "text": "Omit it — the fix is what matters",
       "correct": false,
       "why": "Omitting known causation corrupts the record and guarantees recurrence."
      },
      {
       "text": "Name and shame the engineer who took it",
       "correct": false,
       "why": "Blame ends learning; the next shortcut will just be hidden better."
      }
     ]
    }
   ]
  }
 ],
