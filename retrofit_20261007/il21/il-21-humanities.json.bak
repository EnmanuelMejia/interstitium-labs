 "cheatSheets": [
  {
   "title": "Argument & Fallacy Quick Reference",
   "blocks": [
    {
     "h": "Valid forms",
     "body": "- Modus ponens: P→Q, P ⊢ Q\n- Modus tollens: P→Q, ¬Q ⊢ ¬P\n- Valid = form; sound = valid + true premises"
    },
    {
     "h": "Fallacies",
     "body": "- Ad hominem, straw man, false dilemma, post hoc\n- Appeal to authority, begging the question, slippery slope\n- Name it, then give the substantive reply"
    },
    {
     "h": "Toulmin",
     "body": "- Claim, grounds, warrant, backing, qualifier, rebuttal\n- Fights are usually about warrants"
    }
   ]
  },
  {
   "title": "Ethics Traditions at a Glance",
   "blocks": [
    {
     "h": "The three",
     "body": "- Virtue (Aristotle): what kind of person? Habits, character.\n- Deontology (Kant): duty; universalizable maxims; persons as ends.\n- Consequentialism (Bentham/Mill): maximize good outcomes."
    },
    {
     "h": "Applied moves",
     "body": "- Collingridge: design reversible, anticipatory, humble\n- Dual use: which uses, under what controls?\n- Document misuse, add friction, instrument, preserve override"
    }
   ]
  },
  {
   "title": "Writing & Speaking Checklist",
   "blocks": [
    {
     "h": "Prose",
     "body": "- BLUF; headings; short paragraphs\n- Active voice, concrete subjects, numbers over adjectives\n- Define terms; cut 20% on second pass"
    },
    {
     "h": "Persuasion",
     "body": "- Ethos, pathos, logos (Aristotle)\n- Audience: values, knowledge, decision criteria\n- Persuasion respects agency; manipulation bypasses it"
    }
   ]
  }
 ],
 "answerBank": [
  {
   "q": "Argue for or against deploying a hiring model that is more accurate on average but disadvantages one group.",
   "a": "Framework: (1) Epistemology — what does 'accurate' mean on biased labels? (2) Deontology — does it treat applicants as ends? (3) Consequentialism — aggregate gains vs. concentrated harms, including second-order effects on the applicant pool. (4) Reversibility — can the decision be undone and monitored? A defensible answer works all four and lands on a constrained, monitored pilot or a no-go with reasons — never on the metric alone."
  },
  {
   "q": "Is open-sourcing a powerful model dual-use? What follows?",
   "a": "Framework: identify the mechanism's affordances for benign and harmful uses separately; assess how much the release *marginally* enables harm versus the status quo; consider controls (staged release, use policies, monitoring). 'Neutral' and 'ban it' are both evasions — the answer is always which uses under what controls, with the reasoning documented."
  },
  {
   "q": "Explain a technical trade-off to a non-technical executive.",
   "a": "Framework: stakes first (what changes for them), options with honest trade-offs, recommendation with reasons. One defined term per jargon item, or none. End with the decision you need from them and by when. Anticipate the values question ('is it fair/safe?') and answer it as a values question."
  },
  {
   "q": "A paper claims a breakthrough. How do you read it as an epistemologist?",
   "a": "Framework: Popper — what would falsify it? Kuhn — which paradigm does it extend or challenge? Replication — sample size, pre-registration, effect size with uncertainty, independent replication. Treat it as conjecture until the field converges; never cite the press release."
  },
  {
   "q": "Build vs. buy: make the economic case.",
   "a": "Framework: total cost of ownership over the realistic lifetime — license/fees + integration + operations + opportunity cost of diverted engineers + maintenance. Compare marginal costs at expected scale. Name the sunk-cost fallacy explicitly if past spend is invoked. Decide on forward-looking numbers."
  },
  {
   "q": "Your team is split on a rewrite. How do you decide?",
   "a": "Framework: Toulmin — surface the warrants ('rewrites always fail' vs. 'the debt is fatal'), not just the data. Economics — opportunity cost of the rewrite vs. incremental repair. History — second-system effect (Brooks) as a caution. Decide with a time-boxed spike that could falsify the rewrite case."
  }
 ],
